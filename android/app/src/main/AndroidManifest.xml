<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- first-run model download from Hugging Face (ModelFetch) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the refiner waits for an unmetered network: ConnectivityManager's capabilities need this (a normal,
         install-time permission) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="@string/app_name" android:extractNativeLibs="true">
        <activity android:name=".TestActivity" android:exported="true" android:windowSoftInputMode="stateAlwaysVisible"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- the dictionary editor (from the launcher's Dictionary button); follows the system light or dark mode -->
        <activity android:name=".DictionaryActivity" android:exported="false"
            android:label="Dictionary" android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:windowSoftInputMode="adjustResize" />
        <service android:name=".PhononIME" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
