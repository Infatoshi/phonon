+// Phonon patch: see ggml_cpu_phonon_set in ggml-cpu.h. repack.cpp reads ggml_cpu_phonon_repack_rows.
+static int ggml_cpu_phonon_inherit_qos = 1;
+int ggml_cpu_phonon_repack_rows = 64;
+
+void ggml_cpu_phonon_set(int inherit_qos, int repack_rows) {
+    ggml_cpu_phonon_inherit_qos = inherit_qos;
+    ggml_cpu_phonon_repack_rows = repack_rows;
