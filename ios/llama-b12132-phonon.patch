+        int32_t rc = ggml_thread_create(&workers[j].thrd, wattr, ggml_graph_compute_secondary_thread, &workers[j]);
         GGML_ASSERT(rc == 0);
     }
 
+#if defined(__APPLE__)
+    if (wattr) {
+        pthread_attr_destroy(wattr);
+    }
+#endif
+
     ggml_thread_cpumask_next(tpp->cpumask, workers[0].cpumask, tpp->strict_cpu, &cpumask_iter);
 
     if (!threadpool->pause) {
