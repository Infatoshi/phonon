+    // Phonon patch: give the workers the creating thread's QoS class, so the scheduler treats them like the caller
+#if defined(__APPLE__)
+    pthread_attr_t * wattr = NULL;
+    pthread_attr_t qattr;
+    qos_class_t qos = QOS_CLASS_UNSPECIFIED;
+    int qos_rel = 0;
+    if (ggml_cpu_phonon_inherit_qos && pthread_get_qos_class_np(pthread_self(), &qos, &qos_rel) == 0 &&
+        qos != QOS_CLASS_UNSPECIFIED && pthread_attr_init(&qattr) == 0) {
+        if (pthread_attr_set_qos_class_np(&qattr, qos, qos_rel) == 0) {
+            wattr = &qattr;
+        } else {
+            pthread_attr_destroy(&qattr);
+        }
+    }
+#else
+    void * wattr = NULL;
+#endif
+
     for (int j = 1; j < tpp->n_threads; j++) {
