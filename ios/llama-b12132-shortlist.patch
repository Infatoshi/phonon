+// ---------- Phonon shortlist head ----------
+
+int32_t llama_context::phonon_sl_set_extras(const llama_token * ids, int32_t n_ids) {
+    ggml_tensor * slx = model.output_slx;
+    if (!slx) {
+        return 0;
+    }
+    const int64_t K   = model.phonon_sl_k;
+    const int64_t E   = slx->ne[1];
+    const int64_t n_v = model.output->ne[1];
+    const auto &  ord = model.phonon_sl_order;
+    if ((int64_t) phonon_sl_pos.size() != n_v) {
+        phonon_sl_pos.assign(n_v, -1);
+        for (int64_t s = 0; s < n_v; ++s) {
+            phonon_sl_pos[ord[s]] = (int32_t) s;
+        }
+    }
+    std::vector<int64_t> groups;
+    for (int32_t i = 0; i < n_ids; ++i) {
+        if (ids[i] < 0 || ids[i] >= n_v) {
+            continue;
+        }
+        const int64_t s = phonon_sl_pos[ids[i]];
+        if (s < K) {
+            continue;
+        }
+        const int64_t g = s / 8;
+        if (std::find(groups.begin(), groups.end(), g) == groups.end()) {
+            groups.push_back(g);
+        }
+    }
+    phonon_sl_extra_ids.assign(E, -1);
+    phonon_sl_overflow = (int64_t) groups.size() * 8 > E;
+    if (phonon_sl_overflow) {
+        return -1;
+    }
+    // 8 consecutive rows are one contiguous block both in plain Q4_K and in the repacked 8-row interleaved layout
+    const size_t gbytes = 8 * model.output->nb[1];
+    for (size_t i = 0; i < groups.size(); ++i) {
+        memcpy((char *) slx->data + i * gbytes, (const char *) model.output->data + groups[i] * gbytes, gbytes);
+        for (int j = 0; j < 8; ++j) {
+            phonon_sl_extra_ids[i * 8 + j] = ord[groups[i] * 8 + j];
+        }
+    }
+    return (int32_t) groups.size();
+}
+
+bool llama_context::phonon_sl_rest(const float * h, float * out) {
+    ggml_tensor * W = model.output;
+    const int64_t K      = model.phonon_sl_k;
+    const int64_t n_embd = W->ne[0];
+    const int64_t n_rest = W->ne[1] - K;
+    ggml_init_params ip = { ggml_tensor_overhead() * 8 + ggml_graph_overhead(), nullptr, true };
+    ggml_context * gctx = ggml_init(ip);
+    ggml_tensor * Wr = ggml_view_2d(gctx, W, n_embd, n_rest, W->nb[1], K * W->nb[1]);
+    ggml_tensor * x  = ggml_new_tensor_2d(gctx, GGML_TYPE_F32, n_embd, 1);
+    ggml_tensor * y  = ggml_mul_mat(gctx, Wr, x);
+    std::vector<float> xbuf(h, h + n_embd);
+    x->data = xbuf.data();
+    y->data = out;
+    Wr->data = nullptr;
+    ggml_backend_view_init(Wr);  // buffer, data and the repack traits of the parent weight
+    ggml_cgraph * gf = ggml_new_graph(gctx);
+    ggml_build_forward_expand(gf, y);
+    const bool ok = ggml_backend_graph_compute(backend_cpu, gf) == GGML_STATUS_SUCCESS;
+    ggml_free(gctx);
+    return ok;
+}
+
+llama_token llama_context::phonon_sl_sample(float threshold, int32_t debug, int32_t * out_fallback, float * out_best,
+                                            llama_token * out_sl) {
+    const auto &  ord = model.phonon_sl_order;
+    const int64_t K   = model.phonon_sl_k;
+    const int64_t n_v = (int64_t) ord.size();
+    const float * lg  = get_logits_ith(-1);
+    int32_t best_id = -1;
+    float   best    = -INFINITY;
+    auto consider = [&](float v, int32_t id) {
+        if (v > best || (v == best && id < best_id)) {
+            best    = v;
+            best_id = id;
+        }
+    };
+    for (int64_t s = 0; s < K; ++s) {
+        consider(lg[s], ord[s]);
+    }
+    for (size_t i = 0; i < phonon_sl_extra_ids.size(); ++i) {
+        if (phonon_sl_extra_ids[i] >= 0) {
+            consider(lg[K + i], phonon_sl_extra_ids[i]);
+        }
+    }
+    const bool fb = phonon_sl_overflow || !(best >= threshold);
+    if (out_sl)       *out_sl       = best_id;
+    if (out_best)     *out_best     = best;
+    if (out_fallback) *out_fallback = fb ? 1 : 0;
+    if (!fb && !debug) {
+        return best_id;
+    }
+    phonon_sl_rest_buf.resize(n_v - K);
+    if (phonon_sl_h.empty() || !phonon_sl_rest(phonon_sl_h.data(), phonon_sl_rest_buf.data())) {
+        return best_id;
+    }
+    for (int64_t s = K; s < n_v; ++s) {
+        consider(phonon_sl_rest_buf[s - K], ord[s]);
+    }
+    return best_id;
+}
+
+int32_t llama_context::phonon_sl_full_logits(float * out) {
+    const auto &  ord = model.phonon_sl_order;
+    const int64_t K   = model.phonon_sl_k;
+    const int64_t n_v = (int64_t) ord.size();
+    const float * lg  = get_logits_ith(-1);
+    phonon_sl_rest_buf.resize(n_v - K);
+    if (phonon_sl_h.empty() || !phonon_sl_rest(phonon_sl_h.data(), phonon_sl_rest_buf.data())) {
+        return -1;
+    }
+    for (int64_t s = 0; s < n_v; ++s) {
+        out[ord[s]] = s < K ? lg[s] : phonon_sl_rest_buf[s - K];
+    }
+    return 0;
+}
+
+int32_t llama_phonon_sl_k(const llama_context * ctx) {
+    return (int32_t) ctx->get_model().phonon_sl_k;
+}
+
+int32_t llama_phonon_sl_set_extras(llama_context * ctx, const llama_token * ids, int32_t n_ids) {
+    return ctx->phonon_sl_set_extras(ids, n_ids);
+}
+
+llama_token llama_phonon_sl_sample(llama_context * ctx, float threshold, int32_t debug, int32_t * out_fallback,
+                                   float * out_best_logit, llama_token * out_sl) {
+    return ctx->phonon_sl_sample(threshold, debug, out_fallback, out_best_logit, out_sl);
+}
+
+int32_t llama_phonon_sl_full_logits(llama_context * ctx, float * out_n_vocab) {
+    return ctx->phonon_sl_full_logits(out_n_vocab);
+}
+
 void llama_set_n_threads(llama_context * ctx, int32_t n_threads, int32_t n_threads_batch) {
     ctx->set_n_threads(n_threads, n_threads_batch);
 }
