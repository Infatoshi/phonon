+// [phonon] layer-boundary norm chain: y = rms_norm(x)*w1 + r ; z = rms_norm(y)*w2, optionally also z as q8_1.
+// One block per row, one float4 per thread, the same arithmetic and block reduction as the vectorized rms_norm_f32
+// path (block_size = ncols/4, vpt = 1), so y and z are bit-identical to the two separate kernels. The q8_1 copy
+// repeats quantize_q8_1: per 32 values amax (a max) and the integer sum are order-independent, d = amax/127.
+template <int block_size, bool write_q8>
+static __global__ void rms_norm_chain_f32(
+        const float * x, const float * w1, const float * r, float * y, const float * w2, float * z,
+        block_q8_1 * q8, const int ncols, const float eps1, const float eps2) {
+    // no __restrict__: y and z may alias x or r exactly (see the fusion check)
+    extern __shared__ float s_sum[];
+
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    const float4 * x4  = (const float4 *) (x + (int64_t) row*ncols);
+    const float4 * r4  = (const float4 *) (r + (int64_t) row*ncols);
+    const float4 * w14 = (const float4 *) w1;
+    const float4 * w24 = (const float4 *) w2;
+    float4       * y4  = (float4 *) (y + (int64_t) row*ncols);
+    float4       * z4  = (float4 *) (z + (int64_t) row*ncols);
+
+    const float4 xs = x4[tid];
+    float tmp = 0.0f;
+    tmp += xs.x*xs.x + xs.y*xs.y + xs.z*xs.z + xs.w*xs.w;
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale = rsqrtf(tmp / ncols + eps1);
+
+    float4 a = make_float4(scale*xs.x, scale*xs.y, scale*xs.z, scale*xs.w);
+    {
+        const float4 m = w14[tid];
+        a.x *= m.x;
+        a.y *= m.y;
+        a.z *= m.z;
+        a.w *= m.w;
+        const float4 b = r4[tid];
+        a.x += b.x;
+        a.y += b.y;
+        a.z += b.z;
+        a.w += b.w;
+    }
+    y4[tid] = a;
+
+    if constexpr (block_size > WARP_SIZE) {
+        __syncthreads(); // s_sum is reused by the second reduction
+    }
+
+    float tmp2 = 0.0f;
+    tmp2 += a.x*a.x + a.y*a.y + a.z*a.z + a.w*a.w;
+    tmp2 = block_reduce<block_reduce_method::SUM, block_size>(tmp2, s_sum);
+    const float scale2 = rsqrtf(tmp2 / ncols + eps2);
+
+    float4 o = make_float4(scale2*a.x, scale2*a.y, scale2*a.z, scale2*a.w);
+    {
+        const float4 m = w24[tid];
+        o.x *= m.x;
+        o.y *= m.y;
+        o.z *= m.z;
+        o.w *= m.w;
+    }
+    z4[tid] = o;
+
+    if constexpr (write_q8) {
+        // 8 consecutive threads hold one 32-value q8_1 block
+        float amax = fmaxf(fmaxf(fabsf(o.x), fabsf(o.y)), fmaxf(fabsf(o.z), fabsf(o.w)));
+#pragma unroll
+        for (int off = 4; off > 0; off >>= 1) {
+            amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, off, 32));
+        }
+        const float d = amax / 127.0f;
+        int8_t q0 = 0, q1 = 0, q2 = 0, q3 = 0;
+        if (amax != 0.0f) {
+            q0 = roundf(o.x / d);
+            q1 = roundf(o.y / d);
+            q2 = roundf(o.z / d);
+            q3 = roundf(o.w / d);
+        }
+        int sum = (int) q0 + (int) q1 + (int) q2 + (int) q3;
+#pragma unroll
+        for (int off = 4; off > 0; off >>= 1) {
+            sum += __shfl_xor_sync(0xffffffff, sum, off, 32);
+        }
+        block_q8_1 * blk = q8 + (int64_t) row*(ncols/QK8_1) + tid/8;
+        char4 packed;
+        packed.x = q0;
+        packed.y = q1;
+        packed.z = q2;
+        packed.w = q3;
+        ((char4 *) blk->qs)[tid % 8] = packed;
+        if (tid % 8 == 0) {
+            blk->ds = make_half2(d, d * sum);
+        }
+    }
+}
+
+static bool rms_norm_chain_mul_src(const ggml_tensor * mul, const ggml_tensor * norm, const ggml_tensor ** w) {
+    if (mul->src[0] == norm) {
+        *w = mul->src[1];
+    } else if (mul->src[1] == norm) {
+        *w = mul->src[0];
+    } else {
+        return false;
+    }
+    return true;
+}
