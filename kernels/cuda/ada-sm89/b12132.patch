+// [phonon] batched graph-input uploads. Each decode token the scheduler uploads ~14 tiny input tensors (positions,
+// masks, cache indices) with one memcpy + stream sync apiece, ~5 us of host time each while the GPU idles. Small
+// writes into compute buffers are instead copied into a host staging list (so the caller's memory is free at once)
+// and flushed before any other access to the device: one H2D copy of a pinned staging block plus one scatter kernel.
+struct ggml_cuda_upload_seg {
+    char *   dst;
+    uint32_t off;
+    uint32_t size;
+};
+
+struct ggml_cuda_upload_batch {
+    std::mutex                         mutex;
+    std::vector<ggml_cuda_upload_seg>  segs;
+    std::vector<char>                  data;
+    char *                             pinned      = nullptr;
+    size_t                             pinned_size = 0;
+    char *                             dev         = nullptr;
+    size_t                             dev_size    = 0;
+    cudaEvent_t                        done        = nullptr;
+};
+
+static ggml_cuda_upload_batch g_cuda_upload[GGML_CUDA_MAX_DEVICES];
+
+static constexpr size_t GGML_CUDA_UPLOAD_MAX_SIZE  = 64*1024;
+static constexpr size_t GGML_CUDA_UPLOAD_MAX_TOTAL = 1024*1024;
+
+static __global__ void ggml_cuda_upload_scatter(const char * staging, const int nsegs) {
+    const ggml_cuda_upload_seg seg = ((const ggml_cuda_upload_seg *) staging)[blockIdx.x];
+    const char * src = staging + seg.off;
+    for (uint32_t k = threadIdx.x; k < seg.size; k += blockDim.x) {
+        seg.dst[k] = src[k];
+    }
+    GGML_UNUSED(nsegs);
+}
+
+static void ggml_cuda_flush_uploads_locked(int device, ggml_cuda_upload_batch & b, cudaStream_t stream) {
+    if (b.segs.empty()) {
+        return;
+    }
+    const size_t table = GGML_PAD(b.segs.size()*sizeof(ggml_cuda_upload_seg), 16);
+    const size_t total = table + b.data.size();
+    if (b.done == nullptr) {
+        CUDA_CHECK(cudaEventCreateWithFlags(&b.done, cudaEventDisableTiming));
+    } else {
+        // the previous flush must have finished reading the staging buffers before they are reused
+        CUDA_CHECK(cudaEventSynchronize(b.done));
+    }
+    if (total > b.pinned_size) {
+        if (b.pinned) {
+            CUDA_CHECK(cudaFreeHost(b.pinned));
+        }
+        b.pinned_size = std::max(total, (size_t) 64*1024);
+        CUDA_CHECK(cudaMallocHost((void **) &b.pinned, b.pinned_size));
+    }
+    if (total > b.dev_size) {
+        if (b.dev) {
+            CUDA_CHECK(cudaFree(b.dev));
+        }
+        b.dev_size = std::max(total, (size_t) 64*1024);
+        CUDA_CHECK(cudaMalloc((void **) &b.dev, b.dev_size));
+    }
+    for (ggml_cuda_upload_seg & s : b.segs) {
+        s.off += (uint32_t) table;
+    }
+    memcpy(b.pinned, b.segs.data(), b.segs.size()*sizeof(ggml_cuda_upload_seg));
+    memcpy(b.pinned + table, b.data.data(), b.data.size());
+    CUDA_CHECK(cudaMemcpyAsync(b.dev, b.pinned, total, cudaMemcpyHostToDevice, stream));
+    ggml_cuda_upload_scatter<<<(unsigned) b.segs.size(), 256, 0, stream>>>(b.dev, (int) b.segs.size());
+    CUDA_CHECK(cudaGetLastError());
+    CUDA_CHECK(cudaEventRecord(b.done, stream));
+    b.segs.clear();
+    b.data.clear();
+    GGML_UNUSED(device);
+}
+
+// flush pending uploads of a device on `stream`; callers that use another stream afterwards synchronize it
+static void ggml_cuda_flush_uploads(int device, cudaStream_t stream) {
+    ggml_cuda_upload_batch & b = g_cuda_upload[device];
+    if (b.segs.empty()) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(b.mutex);
+    ggml_cuda_flush_uploads_locked(device, b, stream);
+}
