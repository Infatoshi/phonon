+    ggml_tensor * mul_c = cgraph->nodes[j + 1];
+    const ggml_tensor * w = conv->src[1];
+    if (mul_c->op != GGML_OP_MUL || mul_c->src[1] != conv || conv->src[2] != nullptr ||
+        w->type != GGML_TYPE_F32 || w->ne[0] != L || w->ne[1] != n_embd || !ggml_is_contiguous(w) ||
+        mul_c->type != GGML_TYPE_F32 || ggml_nelements(mul_c) != n_embd || !ggml_is_contiguous(mul_c)) {
+        return 0;
+    }
+    const ggml_tensor * cv = mul_c->src[0];
+    if (cv->type != GGML_TYPE_F32 || cv->ne[0] != n_embd || (const char *) cv->data != (const char *) bv->data + n_embd*sizeof(float)) {
+        return 0;
+    }
+    // the nodes in between must neither use the fused intermediates nor touch the memory the fused kernel writes early
+    const ggml_tensor * fused[] = { mul_bx, tr, cat, snap, conv };
+    for (int k = i + 6; k < j; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (ggml_cuda_phonon_ranges_overlap(n, mul_c) || ggml_cuda_phonon_ranges_overlap(n, cpy)) {
+            return 0;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * src = n->src[s];
+            if (src == nullptr) {
