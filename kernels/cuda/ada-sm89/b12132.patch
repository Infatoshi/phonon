+bool ggml_cuda_rms_norm_chain_supported(const ggml_tensor * rms1, const ggml_tensor * mul1, const ggml_tensor * add,
+                                        const ggml_tensor * rms2, const ggml_tensor * mul2) {
+    const ggml_tensor * w1 = nullptr;
+    const ggml_tensor * w2 = nullptr;
+    if (!rms_norm_chain_mul_src(mul1, rms1, &w1) || !rms_norm_chain_mul_src(mul2, rms2, &w2)) {
+        return false;
+    }
+    const ggml_tensor * r = add->src[0] == mul1 ? add->src[1] : (add->src[1] == mul1 ? add->src[0] : nullptr);
+    if (r == nullptr || rms2->src[0] != add) {
+        return false;
+    }
+    const ggml_tensor * x = rms1->src[0];
+    const int64_t ncols = x->ne[0];
+    const ggml_tensor * all[] = { x, w1, r, add, w2, mul2, rms1, mul1, rms2 };
+    for (const ggml_tensor * t : all) {
+        if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || t->ne[0] != ncols || ((uintptr_t) t->data & 15) != 0) {
+            return false;
+        }
+    }
+    if (!ggml_are_same_shape(x, r) || !ggml_are_same_shape(x, add) || !ggml_are_same_shape(x, mul2) ||
+        ggml_nrows(w1) != 1 || ggml_nrows(w2) != 1 || x->ne[2] != 1 || x->ne[3] != 1) {
+        return false;
+    }
+    // block size must equal what the stock vectorized path picks with vpt = 1
+    const int n4 = ncols / 4;
+    return ncols % 4 == 0 && (n4 == 32 || n4 == 128 || n4 == 256 || n4 == 512 || n4 == 1024);
+}
+
+void ggml_cuda_op_rms_norm_chain(ggml_backend_cuda_context & ctx, ggml_tensor * rms1, ggml_tensor * mul1, ggml_tensor * add,
+                                 ggml_tensor * rms2, ggml_tensor * mul2) {
+    const ggml_tensor * w1 = nullptr;
+    const ggml_tensor * w2 = nullptr;
+    rms_norm_chain_mul_src(mul1, rms1, &w1);
+    rms_norm_chain_mul_src(mul2, rms2, &w2);
+    const ggml_tensor * r = add->src[0] == mul1 ? add->src[1] : add->src[0];
+    const ggml_tensor * x = rms1->src[0];
+
+    float eps1 = 0.0f;
+    float eps2 = 0.0f;
+    memcpy(&eps1, rms1->op_params, sizeof(float));
+    memcpy(&eps2, rms2->op_params, sizeof(float));
+
+    const int     ncols = x->ne[0];
+    const int64_t nrows = ggml_nrows(x);
+    // q8_1 for the single-row (decode) case, where the next op is a mat-vec on mul2
+    const bool write_q8 = nrows == 1 && ncols % MATRIX_ROW_PADDING == 0 &&
+                          (size_t) (ncols/QK8_1)*sizeof(block_q8_1) <= ggml_backend_cuda_context::q8_cache_bytes;
+    block_q8_1 * q8 = write_q8 ? (block_q8_1 *) ctx.q8_cache_get_buf() : nullptr;
+
+    cudaStream_t stream = ctx.stream();
+    const float * xd  = (const float *) x->data;
+    const float * w1d = (const float *) w1->data;
+    const float * rd  = (const float *) r->data;
+    float       * yd  = (float *) add->data;
+    const float * w2d = (const float *) w2->data;
+    float       * zd  = (float *) mul2->data;
+
+#define RMS_NORM_CHAIN_LAUNCH(BS) \
+    if (write_q8) { \
+        rms_norm_chain_f32<BS, true><<<nrows, BS, BS > WARP_SIZE ? 32*sizeof(float) : 0, stream>>>(xd, w1d, rd, yd, w2d, zd, q8, ncols, eps1, eps2); \
+    } else { \
+        rms_norm_chain_f32<BS, false><<<nrows, BS, BS > WARP_SIZE ? 32*sizeof(float) : 0, stream>>>(xd, w1d, rd, yd, w2d, zd, q8, ncols, eps1, eps2); \
+    }
+    switch (ncols / 4) {
+        case 32:   RMS_NORM_CHAIN_LAUNCH(32);   break;
+        case 128:  RMS_NORM_CHAIN_LAUNCH(128);  break;
+        case 256:  RMS_NORM_CHAIN_LAUNCH(256);  break;
+        case 512:  RMS_NORM_CHAIN_LAUNCH(512);  break;
+        case 1024: RMS_NORM_CHAIN_LAUNCH(1024); break;
+        default: GGML_ABORT("unsupported rms_norm chain width");
+    }
+#undef RMS_NORM_CHAIN_LAUNCH
+    CUDA_CHECK(cudaGetLastError());
+
+    if (write_q8) {
+        ctx.q8_cache_tensor = mul2;
+        ctx.q8_cache_data   = mul2->data;
+        ctx.q8_cache_ne     = ncols;
+    }
+}
