+    float full[L];
+#pragma unroll
+    for (int j = 0; j < L - 1; ++j) {
+        full[j] = prev_state[c*(L - 1) + j];
+    }
+    full[L - 1] = bx;
+
+#pragma unroll
+    for (int j = 0; j < L - 1; ++j) {
+        new_state[c*(L - 1) + j] = full[j + 1];
+    }
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (int j = 0; j < L; ++j) {
+        sumf += full[j] * conv_w[c*L + j];
+    }
+    sumf += 0.0f;
+
+    const float out = cg * sumf;
+    y[c] = out;
+
+    if (q8 != nullptr) {
+        const float amax = warp_reduce_max<QK8_1>(fabsf(out));
+        const float  d = amax / 127.0f;
+        const int8_t q = amax == 0.0f ? 0 : roundf(out / d);
+        const int sum = warp_reduce_sum<QK8_1>((int) q);
+        block_q8_1 * blk = q8 + c/QK8_1;
+        blk->qs[c % QK8_1] = q;
+        if (c % QK8_1 == 0) {
+            blk->ds = make_half2(d, d * sum);
+        }
+    }
+}
+
+void ggml_cuda_lfm_shortconv_step(ggml_backend_cuda_context & ctx, const float * bcx, const float * prev_state,
+                                  const float * conv_w, float * new_state, float * y, void * q8, int n_embd, int L) {
+    GGML_ASSERT(L == 7 && n_embd % 128 == 0);
+    const int nblocks = n_embd / 128;
+    lfm_shortconv_step_f32<7><<<nblocks, 128, 0, ctx.stream()>>>(bcx, prev_state, conv_w, new_state, y, (block_q8_1 *) q8, n_embd);
+    CUDA_CHECK(cudaGetLastError());
+}
