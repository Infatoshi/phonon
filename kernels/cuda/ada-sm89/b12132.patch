+// [phonon] LFM short-convolution step for one decode token, replacing MUL(b,x), CONCAT(state, bx), CPY(new state),
+// SSM_CONV and MUL(c, conv) plus the q8_1 quantization of the result for out_proj. One thread per channel.
+// Arithmetic matches the separate kernels: bx = b*x, the taps are summed in order j = 0..L-1 starting from 0 and the
+// (absent) bias 0 is added, y = c*conv; the q8_1 block of 32 channels is one warp, as in quantize_q8_1.
+template <int L>
+static __global__ void lfm_shortconv_step_f32(
+        const float * bcx, const float * prev_state, const float * conv_w, float * new_state, float * y,
+        block_q8_1 * q8, const int n_embd) {
+    const int c = blockIdx.x*blockDim.x + threadIdx.x;
+    if (c >= n_embd) {
+        return;
+    }
+    const float b  = bcx[c];
+    const float cg = bcx[n_embd + c];
+    const float xv = bcx[2*n_embd + c];
