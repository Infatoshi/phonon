+// LFM short conv, one token: MUL(b,x) TRANSPOSE CONCAT(state,bx) VIEW VIEW CPY(new state) ... SSM_CONV MUL(c,conv)
+static int ggml_cuda_try_fuse_lfm_shortconv(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    if (i + 7 >= cgraph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor * mul_bx = cgraph->nodes[i];
+    ggml_tensor * tr     = cgraph->nodes[i + 1];
+    ggml_tensor * cat    = cgraph->nodes[i + 2];
+    ggml_tensor * snap   = cgraph->nodes[i + 3];
+    ggml_tensor * dstv   = cgraph->nodes[i + 4];
+    ggml_tensor * cpy    = cgraph->nodes[i + 5];
+    if (mul_bx->op != GGML_OP_MUL || tr->op != GGML_OP_TRANSPOSE || cat->op != GGML_OP_CONCAT ||
+        snap->op != GGML_OP_VIEW || dstv->op != GGML_OP_VIEW || cpy->op != GGML_OP_CPY) {
+        return 0;
+    }
+    const int64_t n_embd = mul_bx->ne[0];
+    const int64_t L      = cat->ne[0];
+    if (ggml_nrows(mul_bx) != 1 || mul_bx->type != GGML_TYPE_F32 || L != 7 || n_embd % 128 != 0 ||
+        tr->src[0] != mul_bx || cat->src[1] != tr || ggml_get_op_params_i32(cat, 0) != 0 ||
+        cat->ne[1] != n_embd || cat->ne[2] != 1 || cat->type != GGML_TYPE_F32 ||
+        snap->src[0] != cat || snap->view_offs != sizeof(float) || cpy->src[0] != snap || cpy->src[1] != dstv ||
+        cpy->type != GGML_TYPE_F32 || !ggml_is_contiguous(cpy) || ggml_nelements(cpy) != (L - 1)*n_embd) {
+        return 0;
+    }
+    const ggml_tensor * state = cat->src[0];
+    if (state->type != GGML_TYPE_F32 || state->ne[0] != L - 1 || state->ne[1] != n_embd || !ggml_is_contiguous(state)) {
+        return 0;
+    }
+    // b and x are views of the in_proj output at chunks 0 and 2
+    const ggml_tensor * bv = mul_bx->src[0];
+    const ggml_tensor * xv = mul_bx->src[1];
+    if (bv->type != GGML_TYPE_F32 || xv->type != GGML_TYPE_F32 || bv->ne[0] != n_embd || xv->ne[0] != n_embd ||
+        (const char *) xv->data != (const char *) bv->data + 2*n_embd*sizeof(float)) {
+        return 0;
+    }
