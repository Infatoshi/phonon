+    // phonon: single-row q8_1 activation cache for MMVQ. One persistent device buffer holds the q8_1 copy of the
+    // f32 row at q8c_src (ne10 values). Matvecs that read the same row reuse it instead of quantizing again, and
+    // rms_norm kernels can fill it directly. Invalidated when any node writes over q8c_src and at graph start.
+    static constexpr size_t q8c_cap = 64*1024; // bytes, q8_1 for rows of up to 58k values
+    void *       q8c_buf    = nullptr;
+    const void * q8c_src    = nullptr;
+    int64_t      q8c_ne10   = 0;
+    int          q8c_stream = -1;
+
+    void * q8c_buffer() {
+        if (q8c_buf == nullptr) {
+            ggml_cuda_set_device(device);
+            CUDA_CHECK(cudaMalloc(&q8c_buf, q8c_cap));
+        }
+        return q8c_buf;
+    }
+    void q8c_invalidate() { q8c_src = nullptr; q8c_ne10 = 0; q8c_stream = -1; q8c_protect = nullptr; }
+    bool q8c_hit(const void * src, int64_t ne10) const {
+        return q8c_buf != nullptr && src != nullptr && src == q8c_src && ne10 == q8c_ne10 && q8c_stream == curr_stream_no;
+    }
+    void q8c_set(const void * src, int64_t ne10) { q8c_src = src; q8c_ne10 = ne10; q8c_stream = curr_stream_no; }
+    // set by the op that wrote src itself, so the write check right after that op must not drop it
+    const void * q8c_protect = nullptr;
+    void q8c_set_produced(const void * src, int64_t ne10) { q8c_set(src, ne10); q8c_protect = src; }
+    // invalidate if [data, data+nbytes) overlaps the cached source row
+    void q8c_check_write(const void * data, size_t nbytes) {
+        if (q8c_src == nullptr || data == nullptr) {
+            return;
+        }
+        const char * a0 = (const char *) data;
+        const char * b0 = (const char *) q8c_src;
+        if (a0 < b0 + q8c_ne10*sizeof(float) && b0 < a0 + nbytes) {
+            q8c_invalidate();
+        }
+    }
 };
 
