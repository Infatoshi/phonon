+// PHONON_PHASE_TIMING=1: host-side phase timing of single-token decode calls, printed when the context is freed
+namespace {
+struct phonon_phase_timer {
+    enum { PREP, GRAPH, INPUTS, LAUNCH, POST, OUTSIDE, SYNC, N };
+    bool    on   = getenv("PHONON_PHASE_TIMING") != nullptr;
+    int64_t acc[N] = {};
+    int64_t n      = 0;
+    int64_t t_last_exit = 0;
+    int64_t t_entry = 0;
+    int64_t t_launch_end = 0;
+    bool    single = false;
+    struct guard {
+        explicit guard(size_t n_tokens) {
+            if (!g_ptimer_ref().on) { return; }
+            auto & p = g_ptimer_ref();
+            const int64_t t = ggml_time_us();
+            p.single = n_tokens == 1;
+            if (p.single && p.t_last_exit) { p.add(OUTSIDE, p.t_last_exit, t); }
+            p.t_entry = t;
+        }
+        ~guard() {
+            if (!g_ptimer_ref().on) { return; }
+            auto & p = g_ptimer_ref();
+            const int64_t t = ggml_time_us();
+            if (p.single) { p.add(POST, p.t_launch_end, t); p.n++; }
+            p.t_last_exit = p.single ? t : 0;
+        }
+    };
+    static phonon_phase_timer & g_ptimer_ref();
+    std::vector<int64_t> v[N];
+    void add(int i, int64_t t0, int64_t t1) { if (on && single) { acc[i] += t1 - t0; v[i].push_back(t1 - t0); } }
+    static int64_t med(std::vector<int64_t> x) { std::sort(x.begin(), x.end()); return x.empty() ? 0 : x[x.size() / 2]; }
+    void dump() {
+        if (!on || n == 0) { return; }
+        static const char * names[N] = { "decode prep (batch, memory slot)", "graph reuse/build+alloc", "set_inputs (H2D)",
+            "graph_compute launch", "decode post (logits D2H enqueue)", "caller between decodes", "synchronize wait" };
+        fprintf(stderr, "phonon phase timing over %lld single-token decodes (us per token, mean and median):\n", (long long) n);
+        for (int i = 0; i < N; ++i) { fprintf(stderr, "  %-36s %8.1f %8lld\n", names[i], acc[i] / (double) n, (long long) med(v[i])); }
+    }
+} g_ptimer;
+phonon_phase_timer & phonon_phase_timer::g_ptimer_ref() { return g_ptimer; }
+}
