+
+// phonon: one thread per channel. window = [state(d_conv values), b*x]; y = c * sum_j window[j]*w[j]; state' = window[1..].
+// Arithmetic mirrors MUL -> CONCAT -> SSM_CONV -> MUL exactly. Optionally writes y as q8_1 (one warp = one q8_1 block).
+template <int K>
+static __global__ void shortconv_step_f32(
+        const float * __restrict__ state, const int64_t state_nb1,
+        const float * __restrict__ b, const float * __restrict__ x, const float * __restrict__ c,
+        const float * __restrict__ w, const int64_t w_nb1,
+        float * __restrict__ state_out, float * __restrict__ y, void * __restrict__ q8, const int n) {
+    const int ch = blockIdx.x*blockDim.x + threadIdx.x;
+    if (ch >= n) {
+        return;
+    }
+    float win[K];
+#pragma unroll
+    for (int j = 0; j < K - 1; ++j) {
+        win[j] = state[ch*state_nb1 + j];
+    }
+    win[K - 1] = b[ch] * x[ch];
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (int j = 0; j < K; ++j) {
+        sumf += win[j] * w[ch*w_nb1 + j];
+    }
+    sumf += 0.0f;
+
+#pragma unroll
+    for (int j = 0; j < K - 1; ++j) {
+        state_out[ch*(K - 1) + j] = win[j + 1];
+    }
+    const float yi = c[ch] * sumf;
+    y[ch] = yi;
+
+    if (q8 != nullptr) {
+        // same math as quantize_q8_1 (32 lanes = 32 consecutive values)
+        float amax = warp_reduce_max<QK8_1>(fabsf(yi));
+        const float  d = amax / 127.0f;
+        const int8_t q = amax == 0.0f ? 0 : roundf(yi / d);
+        const int  sum = warp_reduce_sum<QK8_1>((int) q);
+        block_q8_1 * yq = (block_q8_1 *) q8 + ch / QK8_1;
+        yq->qs[ch % QK8_1] = q;
+        if (ch % QK8_1 == 0) {
+            yq->ds = make_half2(d, d * sum);
+        }
+    }
+}
+
+bool ggml_cuda_op_shortconv_step_fused(ggml_backend_cuda_context & ctx, const ggml_tensor * mul_bx, const ggml_tensor * concat,
+                                       const ggml_tensor * cpy, const ggml_tensor * conv, ggml_tensor * mul_y) {
+    static const bool disabled = getenv("PHONON_NO_SHORTCONV_FUSION") != nullptr;
+    constexpr int K = 7;
+    const ggml_tensor * state = concat->src[0];
+    const ggml_tensor * w     = conv->src[1];
+    const ggml_tensor * dst_state = cpy->src[1];
+    const ggml_tensor * b = mul_bx->src[0];
+    const ggml_tensor * x = mul_bx->src[1];
+    const ggml_tensor * c = mul_y->src[0];
+    const int n = (int) mul_y->ne[0];
+    if (disabled || concat->ne[0] != K || concat->ne[2] != 1 || concat->ne[1] != n || ggml_get_op_params_i32(concat, 0) != 0 ||
+            w->ne[0] != K || w->ne[1] != n || state->ne[0] != K - 1 || state->ne[1] != n ||
+            mul_bx->ne[0] != n || ggml_nrows(mul_bx) != 1 || ggml_nrows(mul_y) != 1 || conv->ne[0] != n || ggml_nrows(conv) != 1 ||
+            b->ne[0] != n || x->ne[0] != n || c->ne[0] != n || ggml_nrows(b) != 1 || ggml_nrows(x) != 1 || ggml_nrows(c) != 1 ||
+            state->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32 || dst_state->type != GGML_TYPE_F32 ||
+            b->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32 || c->type != GGML_TYPE_F32 || mul_y->type != GGML_TYPE_F32 ||
+            state->nb[0] != sizeof(float) || w->nb[0] != sizeof(float) || b->nb[0] != sizeof(float) || x->nb[0] != sizeof(float) ||
+            c->nb[0] != sizeof(float) || !ggml_is_contiguous(dst_state) || ggml_nelements(dst_state) != (int64_t) (K - 1)*n ||
+            ggml_nelements(cpy->src[0]) != (int64_t) (K - 1)*n ||
+            cpy->src[0]->nb[1] != concat->nb[1] || (const char *) cpy->src[0]->data != (const char *) concat->data + sizeof(float)) {
+        return false;
+    }
+    const bool q8_ok = n % 256 == 0 && size_t(n/QK8_1*sizeof(block_q8_1)) <= ggml_backend_cuda_context::q8c_cap;
+    void * q8 = q8_ok ? ctx.q8c_buffer() : nullptr;
+    const int nth = 256;
+    shortconv_step_f32<K><<<(n + nth - 1)/nth, nth, 0, ctx.stream()>>>(
+        (const float *) state->data, state->nb[1]/sizeof(float),
+        (const float *) b->data, (const float *) x->data, (const float *) c->data,
+        (const float *) w->data, w->nb[1]/sizeof(float),
+        (float *) dst_state->data, (float *) mul_y->data, q8, n);
+    if (q8_ok) {
+        ctx.q8c_set_produced(mul_y->data, n);
+    }
+    return true;
+}
