+// phonon: see norm.cuh. Each thread holds one float4; statement order matches rms_norm_f32's vec path so results are
+// bit-identical to running the fused RMS_NORM/MUL/ADD kernel and then the fused RMS_NORM/MUL kernel.
+template <int block_size>
+static __global__ void __launch_bounds__(block_size, 1) rms_norm_add_rms_norm_f32(
+        const float * __restrict__ x, const float * __restrict__ mul1, const float * __restrict__ addv,
+        const float * __restrict__ mul2, float * __restrict__ dst_add, float * __restrict__ dst2, void * __restrict__ q8,
+        const int ncols, const float eps1, const float eps2) {
+    __shared__ float s_sum[32];
+    const int i = threadIdx.x;
+
+    float4 xs = ((const float4 *) x)[i];
+    float tmp = 0.0f;
+    tmp += xs.x*xs.x + xs.y*xs.y + xs.z*xs.z + xs.w*xs.w;
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale1 = rsqrtf(tmp / ncols + eps1);
+    float4 r = make_float4(scale1*xs.x, scale1*xs.y, scale1*xs.z, scale1*xs.w);
+    {
+        const float4 m = ((const float4 *) mul1)[i];
+        r.x *= m.x;
+        r.y *= m.y;
+        r.z *= m.z;
+        r.w *= m.w;
+        const float4 a = ((const float4 *) addv)[i];
+        r.x += a.x;
+        r.y += a.y;
+        r.z += a.z;
+        r.w += a.w;
+    }
+    ((float4 *) dst_add)[i] = r;
+    __syncthreads(); // s_sum is reused
+
+    xs = r;
+    tmp = 0.0f;
+    tmp += xs.x*xs.x + xs.y*xs.y + xs.z*xs.z + xs.w*xs.w;
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale2 = rsqrtf(tmp / ncols + eps2);
+    r = make_float4(scale2*xs.x, scale2*xs.y, scale2*xs.z, scale2*xs.w);
+    {
+        const float4 m = ((const float4 *) mul2)[i];
+        r.x *= m.x;
+        r.y *= m.y;
+        r.z *= m.z;
+        r.w *= m.w;
+    }
+    ((float4 *) dst2)[i] = r;
+
+    if (q8 != nullptr) {
+        float amax = fmaxf(fmaxf(fabsf(r.x), fabsf(r.y)), fmaxf(fabsf(r.z), fabsf(r.w)));
+        amax = warp_reduce_max<8>(amax);
+        const float d = amax / 127.0f;
+        char4 q;
+        q.x = amax == 0.0f ? 0 : roundf(r.x / d);
+        q.y = amax == 0.0f ? 0 : roundf(r.y / d);
+        q.z = amax == 0.0f ? 0 : roundf(r.z / d);
+        q.w = amax == 0.0f ? 0 : roundf(r.w / d);
+        const int sum = warp_reduce_sum<8>((int) q.x + (int) q.y + (int) q.z + (int) q.w);
+        block_q8_1 * yq = (block_q8_1 *) q8 + i/8;
+        *((char4 *) (yq->qs + 4*(i%8))) = q;
+        if (i % 8 == 0) {
+            yq->ds = make_half2(d, d * sum);
+        }
+    }
