+// phonon: per-token graph inputs (positions, masks, ids, ...) are small host-to-device uploads made between two graph
+// computes. With exactly one backend context on the device, enqueue them on its compute stream instead of a
+// copy + stream sync per input: the graph that reads them runs later on the same stream, and a pageable source has
+// been staged by the time cudaMemcpyAsync returns.
+static bool ggml_cuda_phonon_try_async_upload(int device, void * dst, const void * src, size_t size) {
+    const cudaStream_t stream = g_phonon_compute_stream[device].load(std::memory_order_relaxed);
+    if (size > 65536 || stream == nullptr || g_phonon_ctx_count[device].load(std::memory_order_relaxed) != 1) {
+        return false;
+    }
+    cudaPointerAttributes attr;
+    if (cudaPointerGetAttributes(&attr, src) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    if (attr.type == cudaMemoryTypeHost) {
+        // pinned source (the scheduler's input buffers): a copy from it would really run later, so bounce through
+        // pageable memory, which the driver stages before cudaMemcpyAsync returns; the caller may then reuse src
+        thread_local std::vector<char> bounce;
+        if (bounce.size() < size) {
+            bounce.resize(65536);
+        }
+        memcpy(bounce.data(), src, size);
+        src = bounce.data();
+    } else if (attr.type != cudaMemoryTypeUnregistered) {
+        return false;
+    }
+    CUDA_CHECK(cudaMemcpyAsync(dst, src, size, cudaMemcpyHostToDevice, stream));
+    return true;
+}
