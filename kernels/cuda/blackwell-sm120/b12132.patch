diff --git a/ggml/src/ggml-cuda/phonon-fused.cu b/ggml/src/ggml-cuda/phonon-fused.cu
new file mode 100644
index 0000000..ab1118f
--- /dev/null
+++ b/ggml/src/ggml-cuda/phonon-fused.cu
@@ -0,0 +1,105 @@
+#include "phonon-fused.cuh"
+
+// One thread per channel. Replaces MUL + TRANSPOSE + CONCAT + VIEW + CPY of the conv state update.
+template <int d_conv>
+static __global__ void phonon_shortconv_in_f32(const float * b, const float * x, const float * state, float * cat,
+                                               float * state_out, const int n_embd, const int off) {
+    ggml_cuda_pdl_lc();
+    const int c = blockIdx.x*blockDim.x + threadIdx.x;
+    ggml_cuda_pdl_sync();
+    if (c >= n_embd) {
+        return;
+    }
+    float v[d_conv + 1];
+#pragma unroll
+    for (int t = 0; t < d_conv; ++t) {
+        v[t] = state[c*d_conv + t];
+    }
+    v[d_conv] = b[c] * x[c];
+#pragma unroll
+    for (int t = 0; t <= d_conv; ++t) {
+        cat[c*(d_conv + 1) + t] = v[t];
+    }
+#pragma unroll
+    for (int t = 0; t < d_conv; ++t) {
+        // off is 0 or 1 (checked on the host)
+        state_out[c*d_conv + t] = off ? v[t + 1] : v[t];
+    }
+}
+
+// One thread per channel. Replaces SSM_CONV (one token, no bias) + MUL with the c gate, and the quantize_q8_1 of
+// the out_proj input when q8 != nullptr (one warp = one 32-value block, same math as quantize_q8_1).
+template <int n_taps>
+static __global__ void phonon_ssm_conv_mul_f32(const float * cat, const float * w, const float * gate,
+                                               const float * bias, float * y, block_q8_1 * q8, const int n_embd,
+                                               const int stride_cat, const int stride_w) {
+    ggml_cuda_pdl_lc();
+    const int c = blockIdx.x*blockDim.x + threadIdx.x;
+    ggml_cuda_pdl_sync();
+    if (c >= n_embd) {
+        return;
+    }
+    float xv[n_taps];
+    float wv[n_taps];
+#pragma unroll
+    for (int j = 0; j < n_taps; ++j) {
+        wv[j] = w[c*stride_w + j];
+    }
+    const float bv = bias != nullptr ? bias[c] : 0.0f;
+#pragma unroll
+    for (int j = 0; j < n_taps; ++j) {
+        xv[j] = cat[c*stride_cat + j];
+    }
+    float sumf = 0.0f;
+#pragma unroll
+    for (int j = 0; j < n_taps; ++j) {
+        sumf += xv[j] * wv[j];
+    }
+    sumf += bv;
+    const float r = gate[c] * sumf;
+    y[c] = r;
+
+    if (q8 != nullptr) {
+        float amax = fabsf(r);
+        amax = warp_reduce_max<QK8_1>(amax);
+        const float  d = amax / 127.0f;
+        const int8_t q = amax == 0.0f ? 0 : roundf(r / d);
+        const int  sum = warp_reduce_sum<QK8_1>((int) q);
+        block_q8_1 * yb = q8 + c / QK8_1;
+        yb->qs[c % QK8_1] = q;
+        if (c % QK8_1 == 0) {
+            yb->ds = make_half2(d, d * sum);
+        }
+    }
+}
+
+void ggml_cuda_phonon_shortconv_in(const float * b, const float * x, const float * state, float * cat, float * state_out,
+                                   int n_embd, int d_conv, int off, cudaStream_t stream) {
+    const dim3 block_dims(256, 1, 1);
+    const dim3 block_nums((n_embd + 255) / 256, 1, 1);
+    const ggml_cuda_kernel_launch_params lp(block_nums, block_dims, 0, stream);
+    switch (d_conv) {
+        case 2: ggml_cuda_kernel_launch(phonon_shortconv_in_f32<2>, lp, b, x, state, cat, state_out, n_embd, off); break;
+        case 3: ggml_cuda_kernel_launch(phonon_shortconv_in_f32<3>, lp, b, x, state, cat, state_out, n_embd, off); break;
+        case 4: ggml_cuda_kernel_launch(phonon_shortconv_in_f32<4>, lp, b, x, state, cat, state_out, n_embd, off); break;
+        case 6: ggml_cuda_kernel_launch(phonon_shortconv_in_f32<6>, lp, b, x, state, cat, state_out, n_embd, off); break;
+        default: GGML_ABORT("phonon_shortconv_in: unsupported d_conv %d", d_conv);
+    }
+}
+
+void ggml_cuda_phonon_ssm_conv_mul(const float * cat, const float * w, const float * gate, float * y, void * q8,
+                                   int n_embd, int n_taps, int stride_cat, int stride_w, cudaStream_t stream) {
+    const dim3 block_dims(256, 1, 1);
+    const dim3 block_nums((n_embd + 255) / 256, 1, 1);
+    GGML_ASSERT(q8 == nullptr || n_embd % 256 == 0);
+    const ggml_cuda_kernel_launch_params lp(block_nums, block_dims, 0, stream);
+    const float * bias = nullptr;
+    block_q8_1 * q8b = (block_q8_1 *) q8;
+    switch (n_taps) {
+        case 3: ggml_cuda_kernel_launch(phonon_ssm_conv_mul_f32<3>, lp, cat, w, gate, bias, y, q8b, n_embd, stride_cat, stride_w); break;
+        case 4: ggml_cuda_kernel_launch(phonon_ssm_conv_mul_f32<4>, lp, cat, w, gate, bias, y, q8b, n_embd, stride_cat, stride_w); break;
+        case 5: ggml_cuda_kernel_launch(phonon_ssm_conv_mul_f32<5>, lp, cat, w, gate, bias, y, q8b, n_embd, stride_cat, stride_w); break;
+        case 7: ggml_cuda_kernel_launch(phonon_ssm_conv_mul_f32<7>, lp, cat, w, gate, bias, y, q8b, n_embd, stride_cat, stride_w); break;
+        default: GGML_ABORT("phonon_ssm_conv_mul: unsupported n_taps %d", n_taps);
+    }
+}
