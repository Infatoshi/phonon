diff --git a/ggml/src/ggml-cuda/phonon-no-cublas.cpp b/ggml/src/ggml-cuda/phonon-no-cublas.cpp
new file mode 100644
index 0000000..261163a
--- /dev/null
+++ b/ggml/src/ggml-cuda/phonon-no-cublas.cpp
@@ -0,0 +1,37 @@
+// Phonon refiner-only CUDA build (GGML_CUDA_PHONON_LEAN): cuBLAS is not linked (libcublasLt alone is about
+// 517 MB). The refiner's matrix products are all quantized and go through MMQ/MMVQ, so these entry points are
+// never reached; if one is, it reports CUBLAS_STATUS_NOT_SUPPORTED and ggml's CUBLAS_CHECK aborts with the
+// call site instead of computing a wrong answer. Defined without the cuBLAS headers, with C linkage and the
+// names cublas_v2.h maps to; every stub ignores its arguments (the x86-64 and AArch64 calling conventions
+// leave that safe for an int return).
+
+#include <cstdio>
+
+namespace {
+constexpr int not_supported = 15;  // CUBLAS_STATUS_NOT_SUPPORTED
+
+int refuse(const char * name) {
+    fprintf(stderr, "phonon: %s called, but this CUDA build has no cuBLAS\n", name);
+    return not_supported;
+}
+}  // namespace
+
+#define PHONON_NO_CUBLAS(name) \
+    extern "C" int name() { return refuse(#name); }
+
+PHONON_NO_CUBLAS(cublasCreate_v2)
+PHONON_NO_CUBLAS(cublasDestroy_v2)
+PHONON_NO_CUBLAS(cublasSetStream_v2)
+PHONON_NO_CUBLAS(cublasSetMathMode)
+PHONON_NO_CUBLAS(cublasSetWorkspace_v2)
+PHONON_NO_CUBLAS(cublasGemmEx)
+PHONON_NO_CUBLAS(cublasGemmBatchedEx)
+PHONON_NO_CUBLAS(cublasGemmStridedBatchedEx)
+PHONON_NO_CUBLAS(cublasSgemm_v2)
+PHONON_NO_CUBLAS(cublasSgemmBatched)
+PHONON_NO_CUBLAS(cublasSgemmStridedBatched)
+PHONON_NO_CUBLAS(cublasStrsmBatched)
+
+extern "C" const char * cublasGetStatusString(int) {
+    return "cuBLAS is not part of this Phonon CUDA build";
+}
