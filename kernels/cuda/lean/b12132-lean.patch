diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index bc83ea3..6d8d51a 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -40,6 +40,22 @@
 #include "vendors/cuda.h"
 #endif // defined(GGML_USE_HIP)
 
+// Phonon's refiner-only build (GGML_CUDA_PHONON_LEAN): device code only for the refiner's weight types
+// (Q4_K, Q5_K), its attention head size (128) and an F16 KV cache. Every other template still links, as a
+// host stub that aborts with the case it lacks, so a model outside that set fails loudly instead of silently.
+#ifdef GGML_CUDA_PHONON_LEAN
+static constexpr bool phonon_lean = true;
+static constexpr bool phonon_keep_type(ggml_type t) { return t == GGML_TYPE_Q4_K || t == GGML_TYPE_Q5_K; }
+static constexpr bool phonon_keep_head(int d) { return d == 128; }
+static constexpr bool phonon_keep_kv(ggml_type t) { return t == GGML_TYPE_F16; }
+#else
+static constexpr bool phonon_lean = false;
+static constexpr bool phonon_keep_type(ggml_type) { return true; }
+static constexpr bool phonon_keep_head(int) { return true; }
+static constexpr bool phonon_keep_kv(ggml_type) { return true; }
+#endif // GGML_CUDA_PHONON_LEAN
+#define PHONON_LEAN_ABORT(what) GGML_ABORT("this Phonon build has no CUDA kernel for %s", what)
+
 #define STRINGIZE_IMPL(...) #__VA_ARGS__
 #define STRINGIZE(...) STRINGIZE_IMPL(__VA_ARGS__)
 
