+// Decode (single row) rms_norm chain for batch-1 decode, one block, one float4 per thread:
+//   chain:  h = rms_norm(x)*w1 + res -> out1;  y = rms_norm(h)*w2 -> out2 (+ q8_1 copy of y)
+//   single: y = rms_norm(x)*w2 -> out2 (+ q8_1 copy of y)
+// Arithmetic mirrors rms_norm_f32<block_size, 1, true, ...> and quantize_q8_1 so results are bit-identical.
+// [phonon] No __restrict__: outputs may alias inputs (all reads happen before the first block reduction, out1 is written
+// between the reductions, out2 after the second). PDL-aware so the sm_90+ launch overlap of the stock kernels is kept.
+template <int block_size, bool chain>
+__launch_bounds__(block_size, 1)
+static __global__ void rms_norm_chain_f32(
+        const float * x, const float * w1, const float * res, float * out1, const float eps1,
+        const float * w2, float * out2, const float eps2, block_q8_1 * q8, const int ncols) {
+    ggml_cuda_pdl_lc();
+    extern __shared__ float s_sum[];
+    const int tid = threadIdx.x;
+
+    ggml_cuda_pdl_sync();
+    float4 xs = ((const float4 *) x)[tid];
+    if constexpr (chain) {
+        float tmp = 0.0f;
+        tmp += xs.x*xs.x + xs.y*xs.y + xs.z*xs.z + xs.w*xs.w;
+        tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+        const float scale = rsqrtf(tmp / ncols + eps1);
+        float4 r = make_float4(scale*xs.x, scale*xs.y, scale*xs.z, scale*xs.w);
+        const float4 m = ((const float4 *) w1)[tid];
+        r.x *= m.x;
+        r.y *= m.y;
+        r.z *= m.z;
+        r.w *= m.w;
+        const float4 a = ((const float4 *) res)[tid];
+        r.x += a.x;
+        r.y += a.y;
+        r.z += a.z;
+        r.w += a.w;
+        ((float4 *) out1)[tid] = r;
+        xs = r;
+        __syncthreads(); // s_sum is reused below
+    }
+
+    float tmp = 0.0f;
+    tmp += xs.x*xs.x + xs.y*xs.y + xs.z*xs.z + xs.w*xs.w;
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale = rsqrtf(tmp / ncols + eps2);
+    float4 r = make_float4(scale*xs.x, scale*xs.y, scale*xs.z, scale*xs.w);
+    const float4 m = ((const float4 *) w2)[tid];
+    r.x *= m.x;
+    r.y *= m.y;
+    r.z *= m.z;
+    r.w *= m.w;
+    ((float4 *) out2)[tid] = r;
+
+    // q8_1: 8 threads (32 values) per block
+    float amax = fmaxf(fmaxf(fabsf(r.x), fabsf(r.y)), fmaxf(fabsf(r.z), fabsf(r.w)));
+#pragma unroll
+    for (int off = 1; off < 8; off <<= 1) {
+        amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, off, WARP_SIZE));
+    }
+    const float d = amax / 127.0f;
+    const int8_t q0 = amax == 0.0f ? 0 : roundf(r.x / d);
+    const int8_t q1 = amax == 0.0f ? 0 : roundf(r.y / d);
+    const int8_t q2 = amax == 0.0f ? 0 : roundf(r.z / d);
+    const int8_t q3 = amax == 0.0f ? 0 : roundf(r.w / d);
+    int sum = (int) q0 + (int) q1 + (int) q2 + (int) q3;
+#pragma unroll
+    for (int off = 1; off < 8; off <<= 1) {
+        sum += __shfl_xor_sync(0xffffffff, sum, off, WARP_SIZE);
+    }
+    block_q8_1 * yb = q8 + tid/8;
+    char4 qv;
+    qv.x = q0; qv.y = q1; qv.z = q2; qv.w = q3;
+    *((char4 *) (yb->qs + 4*(tid % 8))) = qv;
+    if (tid % 8 == 0) {
+        yb->ds = make_half2(d, d * sum);
+    }
+}
+
+bool ggml_cuda_rms_norm_chain(cudaStream_t stream, const int ncols,
+        const float * x, const float * w1, const float * res, float * out1, const float eps1,
+        const float * w2, float * out2, const float eps2, void * q8) {
+    const int n4 = ncols / 4;
+    if (ncols % 128 != 0) {
+        return false;
+    }
+#define RMS_NORM_CHAIN_LAUNCH(BS) \
+    do { \
+        const ggml_cuda_kernel_launch_params lp(dim3(1, 1, 1), dim3(BS, 1, 1), 32*sizeof(float), stream); \
+        if (res) { \
+            ggml_cuda_kernel_launch(rms_norm_chain_f32<BS, true>, lp, x, w1, res, out1, eps1, w2, out2, eps2, (block_q8_1 *) q8, ncols); \
+        } else { \
+            ggml_cuda_kernel_launch(rms_norm_chain_f32<BS, false>, lp, x, w1, res, out1, eps1, w2, out2, eps2, (block_q8_1 *) q8, ncols); \
+        } \
+    } while (0)
+    switch (n4) {
+        case  128: RMS_NORM_CHAIN_LAUNCH(128);  break;
+        case  256: RMS_NORM_CHAIN_LAUNCH(256);  break;
+        case  512: RMS_NORM_CHAIN_LAUNCH(512);  break;
+        case 1024: RMS_NORM_CHAIN_LAUNCH(1024); break;
+        default: return false;
+    }
+#undef RMS_NORM_CHAIN_LAUNCH
+    return true;
+}
