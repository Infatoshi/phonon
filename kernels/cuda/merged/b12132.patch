+// [phonon, from the sm_75 track] batch-1 decode fusions. No __restrict__ and PDL-aware (sm_90+), like the stock
+// kernels they replace.
+
+// q8_1 of one value per lane, 32 lanes = one block; mirrors quantize_q8_1
+static __device__ __forceinline__ void decode_store_q8_1(const float v, block_q8_1 * y, const int i) {
+    float amax = fabsf(v);
+    amax = warp_reduce_max<QK8_1>(amax);
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(v / d);
+    const int sum = warp_reduce_sum<QK8_1>((int) q);
+    y[i / QK8_1].qs[i % QK8_1] = q;
+    if (i % QK8_1 == 0) {
+        y[i / QK8_1].ds = make_half2(d, d * sum);
+    }
+}
+
+// Batch-1 decode of an LFM short convolution, one thread per channel:
+//   window = [state (nc-1 values) | b*x];  state <- window[1:];  y = c * sum_j window[j]*w[j]  (+ q8_1 copy of y)
+// Arithmetic mirrors k_bin_bcast(op_mul), concat, cpy, ssm_conv_f32 and quantize_q8_1 bit for bit.
+template <int nc>
+static __global__ void lfm_shortconv_decode_f32(
+        const float * b, const float * c, const float * x,
+        const float * state_in, const int state_in_stride,
+        const float * w, const int w_stride,
+        float * state_out, float * y, block_q8_1 * q8, const int n) {
+    ggml_cuda_pdl_lc();
+    const int ch = blockIdx.x*blockDim.x + threadIdx.x;
+    ggml_cuda_pdl_sync();
+    if (ch >= n) {
+        return;
+    }
+    float win[nc];
+#pragma unroll
+    for (int j = 0; j < nc - 1; ++j) {
+        win[j] = state_in[ch*state_in_stride + j];
+    }
+    win[nc - 1] = b[ch] * x[ch];
+#pragma unroll
+    for (int j = 0; j < nc - 1; ++j) {
+        state_out[ch*(nc - 1) + j] = win[j + 1];
+    }
+    float sumf = 0.0f;
+#pragma unroll
+    for (int j = 0; j < nc; ++j) {
+        sumf += win[j] * w[ch*w_stride + j];
+    }
+    const float bias = 0.0f;
+    sumf += bias;
+    const float v = c[ch] * sumf;
+    y[ch] = v;
+    if (q8) {
+        decode_store_q8_1(v, q8, ch);
+    }
+}
+
+bool ggml_cuda_lfm_shortconv_decode(cudaStream_t stream, const int nc, const int n,
+        const float * b, const float * c, const float * x, const float * state_in, const int state_in_stride,
+        const float * w, const int w_stride, float * state_out, float * y, void * q8) {
+    if (n % 256 != 0) {
+        return false;
+    }
+    const ggml_cuda_kernel_launch_params lp(dim3(n/256, 1, 1), dim3(256, 1, 1), 0, stream);
+    block_q8_1 * q8b = (block_q8_1 *) q8;
+    switch (nc) {
+        case 3: ggml_cuda_kernel_launch(lfm_shortconv_decode_f32<3>, lp, b, c, x, state_in, state_in_stride, w, w_stride, state_out, y, q8b, n); break;
+        case 4: ggml_cuda_kernel_launch(lfm_shortconv_decode_f32<4>, lp, b, c, x, state_in, state_in_stride, w, w_stride, state_out, y, q8b, n); break;
+        case 7: ggml_cuda_kernel_launch(lfm_shortconv_decode_f32<7>, lp, b, c, x, state_in, state_in_stride, w, w_stride, state_out, y, q8b, n); break;
+        default: return false;
+    }
+    return true;
+}
+
+// Batch-1 decode attention output gate: y[h*hd + d] = attn[h*hd + d] * sigmoid(g[h])  (+ q8_1 copy of y).
+// Mirrors unary op_sigmoid followed by k_bin_bcast(op_mul) and quantize_q8_1.
+static __global__ void attn_gate_decode_f32(const float * attn, const float * g, const int hd,
+        float * y, block_q8_1 * q8, const int n) {
+    ggml_cuda_pdl_lc();
+    const int i = blockIdx.x*blockDim.x + threadIdx.x;
+    ggml_cuda_pdl_sync();
+    if (i >= n) {
+        return;
+    }
+    const float gx = g[i / hd];
+    const float s  = 1.0f / (1.0f + expf(-gx));
+    const float v  = attn[i] * s;
+    y[i] = v;
+    if (q8) {
+        decode_store_q8_1(v, q8, i);
+    }
+}
+
+bool ggml_cuda_attn_gate_decode(cudaStream_t stream, const int n, const int hd,
+        const float * attn, const float * g, float * y, void * q8) {
+    if (n % 256 != 0 || hd % QK8_1 != 0) {
+        return false;
+    }
+    const ggml_cuda_kernel_launch_params lp(dim3(n/256, 1, 1), dim3(256, 1, 1), 0, stream);
+    ggml_cuda_kernel_launch(attn_gate_decode_f32, lp, attn, g, hd, y, (block_q8_1 *) q8, n);
+    return true;
+}
