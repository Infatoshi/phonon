+// [phonon] which GPUs take phonon_mmvq_q4k. The Ampere track measured it 1.7% faster than the stock Q4_K matvec on a
+// 260 W rented 3090 without the other fusions; on top of the merged fusions it measured ~1% slower on a local 420 W 3090
+// (65.7-65.9 vs 65.1-65.2 ms/dictation), so it is off by default (PHONON_Q4K_MMVQ_DEFAULT_ON compiles the Ampere
+// default back in). PHONON_Q4K_MMVQ=1 turns it on for any NVIDIA GPU, PHONON_NO_Q4K_MMVQ=1 forces it off. It sums the
+// same dp4a partials in a different cross-thread order, so logits are not bit-identical to stock.
+static bool phonon_mmvq_q4k_enabled() {
+    static const int state = [] {
+        if (getenv("PHONON_NO_Q4K_MMVQ") != nullptr) {
+            return 0;
+        }
+        const char * on = getenv("PHONON_Q4K_MMVQ");
+        if (on != nullptr) {
+            return atoi(on) != 0 ? 1 : 0;
+        }
+        return -1;
+    }();
+    if (state >= 0) {
+        return state == 1;
+    }
+#ifdef PHONON_Q4K_MMVQ_DEFAULT_ON
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    return GGML_CUDA_CC_IS_NVIDIA(cc) && cc >= GGML_CUDA_CC_AMPERE && cc < GGML_CUDA_CC_ADA_LOVELACE;
+#else
+    return false;
+#endif
+}
