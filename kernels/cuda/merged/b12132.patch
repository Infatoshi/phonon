+// [phonon, from the Ampere track] batch-1 Q4_K x q8_1 matvec with 16-byte weight loads.
+// One warp per output row; 8 lanes cover one 256-value Q4_K super-block (lane c of 8 reads qs[16c, 16c+16), i.e. half
+// of sub-blocks 2j and 2j+1 with j = c/2), so a warp streams 4 super-blocks (576 bytes) per iteration.
+// Optionally computes a second matrix (gate) on the same activations and applies SWIGLU: dst = x * silu(gate).
+#define PHONON_Q4K_WARPS 4
+#ifndef PHONON_Q4K_ROWS
+#define PHONON_Q4K_ROWS 1 // 2 rows per warp measured slower on the 3090 (output matvec 183 -> 193 us)
+#endif
+#ifndef PHONON_Q4K_ROWS_GATE
+#define PHONON_Q4K_ROWS_GATE 1
+#endif
+
+template <bool has_gate>
+static __device__ __forceinline__ void phonon_q4k_accum(
+        const block_q4_K * __restrict__ bx, const int4 * __restrict__ hdr, const int4 qsv,
+        const int * __restrict__ u, const float2 d8a, const float2 d8b, const int j, const int h, float & acc) {
+    // header: dm (half2) + scales[12]
+    const int4 hv = *hdr;
+    const half2 dm = *((const half2 *) &hv.x);
+    const uint8_t * scales = ((const uint8_t *) &hv) + 4;
+    const int sb0 = 2*j;
+    const int sb1 = 2*j + 1;
+    uint8_t sc0, m0, sc1, m1;
+    if (sb0 < 4) { sc0 = scales[sb0] & 63; m0 = scales[sb0 + 4] & 63; }
+    else { sc0 = (scales[sb0 + 4] & 0xF) | ((scales[sb0 - 4] >> 6) << 4); m0 = (scales[sb0 + 4] >> 4) | ((scales[sb0] >> 6) << 4); }
+    if (sb1 < 4) { sc1 = scales[sb1] & 63; m1 = scales[sb1 + 4] & 63; }
+    else { sc1 = (scales[sb1 + 4] & 0xF) | ((scales[sb1 - 4] >> 6) << 4); m1 = (scales[sb1 + 4] >> 4) | ((scales[sb1] >> 6) << 4); }
+
+    const int v[4] = { qsv.x, qsv.y, qsv.z, qsv.w };
+    int dot0 = 0, dot1 = 0, s0 = 0, s1 = 0;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        dot0 = ggml_cuda_dp4a( v[k]       & 0x0F0F0F0F, u[k],     dot0);
+        dot1 = ggml_cuda_dp4a((v[k] >> 4) & 0x0F0F0F0F, u[4 + k], dot1);
+        s0   = ggml_cuda_dp4a(0x01010101, u[k],     s0);
+        s1   = ggml_cuda_dp4a(0x01010101, u[4 + k], s1);
+    }
+    const float sumf_d = d8a.x * (dot0 * sc0) + d8b.x * (dot1 * sc1);
+    const float sumf_m = d8a.x * (s0 * m0)    + d8b.x * (s1 * m1);
+    const float2 dmf = __half22float2(dm);
+    acc += dmf.x*sumf_d - dmf.y*sumf_m;
+    GGML_UNUSED(bx); GGML_UNUSED(h);
+}
+
+template <bool has_gate, int R>
+__launch_bounds__(PHONON_Q4K_WARPS*WARP_SIZE, 1)
+static __global__ void phonon_mmvq_q4k(
+        const void * __restrict__ vx, const void * __restrict__ vgate, const block_q8_1 * __restrict__ y,
+        float * __restrict__ dst, const int nblocks, const int nrows, const int64_t stride_row) {
+    const int lane = threadIdx.x;
+    const int row  = (blockIdx.x*PHONON_Q4K_WARPS + threadIdx.y)*R;
+    if (row >= nrows) {
+        return;
+    }
+    const int c = lane % 8;     // 16-byte chunk of qs
+    const int j = c / 2;        // sub-block pair
+    const int h = c % 2;        // half of the 32-value sub-block
+    const block_q4_K * bx = (const block_q4_K *) vx + row*stride_row;
+    const block_q4_K * bg = has_gate ? (const block_q4_K *) vgate + row*stride_row : nullptr;
+
+    // R rows per warp share each activation load
+    float acc[R];
+    float accg[R];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        acc[r]  = 0.0f;
+        accg[r] = 0.0f;
+    }
+
+#pragma unroll 2
+    for (int kb = lane / 8; kb < nblocks; kb += 4) {
+        int4 qsv[R];
+        int4 hdv[R];
+        int4 qsg[R];
+        int4 hdg[R];
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            if (R == 1 || row + r < nrows) {
+                qsv[r] = *((const int4 *) (bx[r*stride_row + kb].qs + 16*c));
+                hdv[r] = *((const int4 *) (bx + r*stride_row + kb));
+                if constexpr (has_gate) {
+                    qsg[r] = *((const int4 *) (bg[r*stride_row + kb].qs + 16*c));
+                    hdg[r] = *((const int4 *) (bg + r*stride_row + kb));
+                }
+            }
+        }
+        const block_q8_1 * ya = y + kb*8 + 2*j;
+        const block_q8_1 * yb = ya + 1;
+        int u[8];
+        const int * qa = (const int *) ya->qs + 4*h;
+        const int * qb = (const int *) yb->qs + 4*h;
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            u[k]     = qa[k];
+            u[4 + k] = qb[k];
+        }
+        const float2 d8a = __half22float2(ya->ds);
+        const float2 d8b = __half22float2(yb->ds);
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            if (R == 1 || row + r < nrows) {
+                phonon_q4k_accum<has_gate>(bx, &hdv[r], qsv[r], u, d8a, d8b, j, h, acc[r]);
+                if constexpr (has_gate) {
+                    phonon_q4k_accum<has_gate>(bg, &hdg[r], qsg[r], u, d8a, d8b, j, h, accg[r]);
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        acc[r] = warp_reduce_sum(acc[r]);
+        if constexpr (has_gate) {
+            accg[r] = warp_reduce_sum(accg[r]);
+        }
+        if (lane == 0 && (R == 1 || row + r < nrows)) {
+            float result = acc[r];
+            if constexpr (has_gate) {
+                result *= ggml_cuda_op_silu_single(accg[r]);
+            }
+            dst[row + r] = result;
+        }
+    }
+}
