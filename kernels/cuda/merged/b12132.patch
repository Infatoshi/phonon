+static void ggml_cuda_flush_uploads_locked(int device, ggml_cuda_upload_batch & b, cudaStream_t stream) {
+    if (b.segs.empty()) {
+        return;
+    }
+    const size_t table = GGML_PAD(b.segs.size()*sizeof(ggml_cuda_upload_seg), 16);
+    const size_t total = table + b.data.size();
