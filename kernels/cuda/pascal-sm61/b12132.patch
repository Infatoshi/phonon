+// ints of q4_K quants per thread in the Pascal q4_K matvec (stock: 2). More per thread amortizes the scale
+// decode and index math, which matter on Pascal where the matvec is close to issue-bound.
+#ifndef MMVQ_PASCAL_Q4K_VDR
+#define MMVQ_PASCAL_Q4K_VDR 4
+#endif
