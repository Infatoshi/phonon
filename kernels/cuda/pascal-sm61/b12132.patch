+static constexpr __host__ __device__ bool mmvq_pascal_tuned_type(ggml_type type) {
+    return type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K || type == GGML_TYPE_Q6_K;
+}
+
+// q4_K x q8_1 dot product over VDR contiguous ints of one 32-byte quant group (64 weights: low nibbles belong to
+// sub-block 2g, high nibbles to sub-block 2g+1). iqs = VDR*t selects group g = iqs/8 and ints iqs%8 .. iqs%8+VDR-1.
+template <int VDR>
+static __device__ __forceinline__ float vec_dot_q4_K_q8_1_pascal(
+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+    static_assert(VDR == 2 || VDR == 4 || VDR == 8, "bad VDR");
+
+    const block_q4_K * bq4_K = (const block_q4_K *) vbq + kbx;
+
+    const int g  = iqs / 8;
+    const int w0 = iqs % 8;
+
+    int v[VDR];
+    const int * q4 = (const int *) (bq4_K->qs + 32*g) + w0;
+    if constexpr (VDR == 2) {
+        const int2 t = *(const int2 *) q4;
+        v[0] = t.x; v[1] = t.y;
+    } else {
+#pragma unroll
+        for (int l = 0; l < VDR/4; ++l) {
+            const int4 t = ((const int4 *) q4)[l];
+            v[4*l+0] = t.x; v[4*l+1] = t.y; v[4*l+2] = t.z; v[4*l+3] = t.w;
+        }
+    }
+
+    const uint16_t * scales = (const uint16_t *) bq4_K->scales;
+    const int jm = g & 1;
+
+    const uint32_t s0 = scales[jm + 0];
+    const uint32_t s2 = scales[jm + 2];
+    const uint32_t s4 = scales[jm + 4];
+
+    const uint32_t hi = (uint32_t) -(int32_t) (g >= 2);
+
+    uint16_t aux[2];
+    aux[0] = (uint16_t) (((s0 & 0x3f3f) & ~hi) | ((((s4 >> 0) & 0x0f0f) | ((s0 & 0xc0c0) >> 2)) & hi));
+    aux[1] = (uint16_t) (((s2 & 0x3f3f) & ~hi) | ((((s4 >> 4) & 0x0f0f) | ((s2 & 0xc0c0) >> 2)) & hi));
+    const uint8_t * sc = (const uint8_t *) aux;
+    const uint8_t * m  = sc + 2;
+
+    float sumf_d = 0.0f;
+    float sumf_m = 0.0f;
+
+#pragma unroll
+    for (int i = 0; i < QR4_K; ++i) {
+        const block_q8_1 * bq8i = bq8_1 + 2*g + i;
+        const float d8 = __low2float(bq8i->ds);
+        const int * q8 = (const int *) bq8i->qs + w0;
+
+        int dot1 = 0;
+        int dot2 = 0;
+#pragma unroll
+        for (int l = 0; l < VDR; ++l) {
+            const int u = q8[l];
+            dot1 = ggml_cuda_dp4a((v[l] >> (4*i)) & 0x0F0F0F0F, u, dot1);
+            dot2 = ggml_cuda_dp4a(0x01010101, u, dot2);
+        }
+
+        sumf_d += d8 * (dot1 * sc[i]);
+        sumf_m += d8 * (dot2 * m[i]);
+    }
+
+    const float2 dm4f = __half22float2(bq4_K->dm);
+
+    return dm4f.x*sumf_d - dm4f.y*sumf_m;
+}
