+bool ggml_cuda_lfm_shortconv_decode(cudaStream_t stream, const int nc, const int n,
+        const float * b, const float * c, const float * x, const float * state_in, const int state_in_stride,
+        const float * w, const int w_stride, float * state_out, float * y, void * q8) {
