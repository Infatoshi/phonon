+// gated attention output, batch 1: SIGMOID(g) -> RESHAPE -> MUL(attn, .)
+static int ggml_cuda_try_decode_attn_gate(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    ggml_cuda_q8_cache & q8c = ggml_cuda_get_q8_cache(cuda_ctx);
+    const ggml_tensor * sg = cgraph->nodes[i];
+    if (!q8c.enabled || sg->op != GGML_OP_UNARY || ggml_get_unary_op(sg) != GGML_UNARY_OP_SIGMOID || i + 1 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * g  = sg->src[0];
+    const ggml_tensor * rs = cgraph->nodes[i + 1];
+    if (rs->op != GGML_OP_RESHAPE || rs->src[0] != sg || sg->type != GGML_TYPE_F32 || g->type != GGML_TYPE_F32 ||
+        ggml_nrows(sg) != 1 || !ggml_is_contiguous(g) || !ggml_is_contiguous(sg)) {
+        return 0;
+    }
+    const int64_t n_head = sg->ne[0];
+    const std::vector<int> u_sg = ggml_cuda_decode_users(cgraph, i, sg);
+    const std::vector<int> u_rs = ggml_cuda_decode_users(cgraph, i + 1, rs);
+    if (u_sg.size() != 1 || u_rs.size() != 1) {
+        return 0;
+    }
+    const ggml_tensor * mm = cgraph->nodes[u_rs[0]];
+    if (mm->op != GGML_OP_MUL || mm->src[1] != rs || mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm)) {
+        return 0;
+    }
+    const ggml_tensor * a = mm->src[0];
+    const int64_t hd = a->ne[0];
+    if (a->type != GGML_TYPE_F32 || !ggml_is_contiguous(a) || a->ne[1] != n_head || a->ne[2] != 1 || a->ne[3] != 1 ||
+        rs->ne[0] != 1 || rs->ne[1] != n_head || !ggml_are_same_shape(mm, a)) {
+        return 0;
+    }
+    const int64_t n = hd*n_head;
+    if (ggml_cuda_ranges_overlap(a->data, ggml_nbytes(a), mm->data, n*sizeof(float)) ||
+        ggml_cuda_ranges_overlap(g->data, ggml_nbytes(g), mm->data, n*sizeof(float))) {
+        return 0;
+    }
+    const std::vector<const ggml_tensor *> fused = { sg, rs, mm };
+    if (!ggml_cuda_decode_fusion_safe(q8c, cgraph, i, u_rs[0], fused, { { mm->data, n*sizeof(float) } }, { a, g })) {
+        return 0;
+    }
+    void * q8 = q8c.get_buf(n/QK8_1*sizeof(block_q8_1), cuda_ctx->stream());
+    if (!ggml_cuda_attn_gate_decode(cuda_ctx->stream(), n, hd, (const float *) a->data, (const float *) g->data, (float *) mm->data, q8)) {
+        return 0;
+    }
+    q8c.done.insert(mm);
+    q8c.src = nullptr; // the done nodes are not scanned, so never keep an older entry
+    if (q8) {
+        q8c.src        = mm->data;
+        q8c.ne         = n;
+        q8c.next_check = i + 2;
+    }
+    return 1; // node i + 1 is the reshape view
+}
