+// Single-entry cache of the q8_1 copy of a batch-1 mul_mat_vec_q activation (decode).
+// Producers (mmvq itself, or the fused decode rms_norm) fill buf and set src; consumers whose src1
+// is src reuse it instead of quantizing again. The graph evaluator enables it only for single-stream
+// evaluation, clears it at the start of every graph and drops the entry when a node writes over src.
+struct ggml_cuda_q8_cache {
+    void       * buf        = nullptr;
+    size_t       size       = 0;
+    const void * src        = nullptr;
+    int64_t      ne         = 0;
+    int          next_check = 0;     // first node index the evaluator still has to check
+    bool         enabled    = false;
+    std::unordered_set<const ggml_tensor *> done; // nodes already computed by an earlier fused kernel
+
+    // the buffer if it can hold nbytes, else nullptr (callers fall back to the pool);
+    // allocated once outside of stream capture and never moved, so captured CUDA graphs stay valid
+    void * get_buf(size_t nbytes, cudaStream_t stream) {
+        if (buf == nullptr) {
+            cudaStreamCaptureStatus st = cudaStreamCaptureStatusNone;
+            CUDA_CHECK(cudaStreamIsCapturing(stream, &st));
+            if (st != cudaStreamCaptureStatusNone) {
+                return nullptr;
+            }
+            size = 1u << 20;
+            CUDA_CHECK(cudaMalloc(&buf, size));
+        }
+        return nbytes <= size ? buf : nullptr;
+    }
