+    switch (nc) {
+        case 3: lfm_shortconv_decode_f32<3><<<grid, block, 0, stream>>>(b, c, x, state_in, state_in_stride, w, w_stride, state_out, y, (block_q8_1 *) q8, n); break;
+        case 4: lfm_shortconv_decode_f32<4><<<grid, block, 0, stream>>>(b, c, x, state_in, state_in_stride, w, w_stride, state_out, y, (block_q8_1 *) q8, n); break;
+        case 7: lfm_shortconv_decode_f32<7><<<grid, block, 0, stream>>>(b, c, x, state_in, state_in_stride, w, w_stride, state_out, y, (block_q8_1 *) q8, n); break;
