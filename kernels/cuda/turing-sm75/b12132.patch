+// ---- batch-1 decode fusions that skip non-adjacent nodes (they are put into q8c.done) ----
+
+// nodes after i that read t
+static std::vector<int> ggml_cuda_decode_users(const ggml_cgraph * cgraph, int i, const ggml_tensor * t) {
+    std::vector<int> users;
+    for (int k = i + 1; k < cgraph->n_nodes; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (n->src[s] == t) {
+                users.push_back(k);
+                break;
+            }
+        }
+    }
+    return users;
+}
