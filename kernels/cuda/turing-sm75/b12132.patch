+// q8_1 of one value per lane, 32 lanes = one block; mirrors quantize_q8_1
+static __device__ __forceinline__ void decode_store_q8_1(const float v, block_q8_1 * y, const int i) {
+    float amax = fabsf(v);
+    amax = warp_reduce_max<QK8_1>(amax);
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(v / d);
+    const int sum = warp_reduce_sum<QK8_1>((int) q);
+    y[i / QK8_1].qs[i % QK8_1] = q;
+    if (i % QK8_1 == 0) {
+        y[i / QK8_1].ds = make_half2(d, d * sum);
+    }
