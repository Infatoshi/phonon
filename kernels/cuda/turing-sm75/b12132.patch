+static bool ggml_cuda_ranges_overlap(const void * a, size_t na, const void * b, size_t nb) {
+    const char * a0 = (const char *) a;
+    const char * b0 = (const char *) b;
+    return a0 < b0 + nb && b0 < a0 + na;
+}
+
+// The fused kernel runs at node i, reading `reads` and writing `writes` early. Check that no node in (i, last]
+// that still runs reads or writes what it wrote, or writes what it read (it would have been read later).
+static bool ggml_cuda_decode_fusion_safe(const ggml_cuda_q8_cache & q8c, const ggml_cgraph * cgraph, int i, int last,
+        const std::vector<const ggml_tensor *> & fused, const std::vector<std::pair<const void *, size_t>> & writes,
+        const std::vector<const ggml_tensor *> & reads) {
+    for (int k = i + 1; k <= last; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (ggml_cuda_is_view_or_noop(n) || q8c.done.count(n) || std::find(fused.begin(), fused.end(), n) != fused.end()) {
+            continue;
+        }
+        for (const ggml_tensor * r : reads) {
+            if (ggml_cuda_ranges_overlap(n->data, ggml_nbytes(n), r->data, ggml_nbytes(r))) {
+                return false;
+            }
+        }
+        for (const auto & w : writes) {
+            if (ggml_cuda_ranges_overlap(n->data, ggml_nbytes(n), w.first, w.second)) {
+                return false;
+            }
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (n->src[s] && ggml_cuda_ranges_overlap(n->src[s]->data, ggml_nbytes(n->src[s]), w.first, w.second)) {
+                    return false;
+                }
+            }
+        }
+    }
+    for (const ggml_tensor * t : fused) {
+        if (t->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ggml_cuda_decode_vec_ok(const ggml_tensor * t, int64_t n) {
+    return t->type == GGML_TYPE_F32 && t->ne[0] == n && ggml_nrows(t) == 1 && t->nb[0] == sizeof(float);
+}
+
+// LFM short conv, batch 1: MUL(b,x) -> TRANSPOSE -> CONCAT(state, .) -> {VIEW -> CPY(state), SSM_CONV -> MUL(c, .)}
+static int ggml_cuda_try_decode_shortconv(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    ggml_cuda_q8_cache & q8c = ggml_cuda_get_q8_cache(cuda_ctx);
+    const ggml_tensor * mbx = cgraph->nodes[i];
+    if (!q8c.enabled || mbx->op != GGML_OP_MUL || i + 1 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const int64_t n = mbx->ne[0];
+    const ggml_tensor * tr = cgraph->nodes[i + 1];
+    if (tr->op != GGML_OP_TRANSPOSE || tr->src[0] != mbx || !ggml_cuda_decode_vec_ok(mbx, n)) {
+        return 0;
+    }
+    const std::vector<int> u_mbx = ggml_cuda_decode_users(cgraph, i, mbx);
+    const std::vector<int> u_tr  = ggml_cuda_decode_users(cgraph, i + 1, tr);
+    if (u_mbx.size() != 1 || u_tr.size() != 1) {
+        return 0;
+    }
+    const ggml_tensor * cc = cgraph->nodes[u_tr[0]];
+    if (cc->op != GGML_OP_CONCAT || cc->src[1] != tr || ggml_get_op_params_i32(cc, 0) != 0 || cc->type != GGML_TYPE_F32) {
+        return 0;
+    }
+    const int nc = cc->ne[0];
+    const ggml_tensor * st = cc->src[0];
+    if (cc->ne[1] != n || cc->ne[2] != 1 || cc->ne[3] != 1 || !ggml_is_contiguous(cc) ||
+        st->type != GGML_TYPE_F32 || st->ne[0] != nc - 1 || st->ne[1] != n || st->ne[2] != 1 || st->ne[3] != 1 ||
+        st->nb[0] != sizeof(float) || st->nb[1] % sizeof(float) != 0) {
+        return 0;
+    }
+    const std::vector<int> u_cc = ggml_cuda_decode_users(cgraph, u_tr[0], cc);
+    if (u_cc.size() != 2) {
+        return 0;
+    }
+    const ggml_tensor * vw = nullptr;
+    const ggml_tensor * sc = nullptr;
+    for (int k : u_cc) {
+        const ggml_tensor * t = cgraph->nodes[k];
+        if (t->op == GGML_OP_VIEW && t->src[0] == cc) {
+            vw = t;
+        } else if (t->op == GGML_OP_SSM_CONV && t->src[0] == cc) {
+            sc = t;
+        }
+    }
+    if (!vw || !sc) {
+        return 0;
+    }
+    const std::vector<int> u_vw = ggml_cuda_decode_users(cgraph, (int) (std::find(cgraph->nodes, cgraph->nodes + cgraph->n_nodes, vw) - cgraph->nodes), vw);
+    const std::vector<int> u_sc = ggml_cuda_decode_users(cgraph, u_cc[0], sc);
+    if (u_vw.size() != 1 || u_sc.size() != 1) {
+        return 0;
+    }
+    const ggml_tensor * cp = cgraph->nodes[u_vw[0]];
+    const ggml_tensor * mc = cgraph->nodes[u_sc[0]];
+    const ggml_tensor * w  = sc->src[1];
+    if (cp->op != GGML_OP_CPY || cp->src[0] != vw || cp->type != GGML_TYPE_F32 || !ggml_is_contiguous(cp) ||
+        ggml_nelements(cp) != (nc - 1)*n ||
+        vw->view_offs != sizeof(float) || vw->ne[0] != nc - 1 || vw->ne[1] != n || vw->nb[1] != cc->nb[1] ||
+        sc->type != GGML_TYPE_F32 || sc->ne[0] != n || ggml_nrows(sc) != 1 ||
+        w->type != GGML_TYPE_F32 || w->ne[0] != nc || w->ne[1] != n || w->nb[0] != sizeof(float) ||
+        mc->op != GGML_OP_MUL || !ggml_cuda_decode_vec_ok(mc, n) || !ggml_is_contiguous(mc)) {
+        return 0;
+    }
+    const ggml_tensor * c = mc->src[0] == sc ? mc->src[1] : mc->src[0];
+    const ggml_tensor * b = mbx->src[0];
+    const ggml_tensor * x = mbx->src[1];
+    if (!ggml_cuda_decode_vec_ok(c, n) || !ggml_cuda_decode_vec_ok(b, n) || !ggml_cuda_decode_vec_ok(x, n)) {
+        return 0;
+    }
+    const size_t ny = n*sizeof(float);
+    const size_t ns = (nc - 1)*n*sizeof(float);
+    for (const ggml_tensor * r : { b, c, x, st, w }) {
+        if (ggml_cuda_ranges_overlap(r->data, ggml_nbytes(r), mc->data, ny) || ggml_cuda_ranges_overlap(r->data, ggml_nbytes(r), cp->data, ns)) {
+            return 0;
+        }
+    }
+    const int last = std::max(u_vw[0], u_sc[0]);
+    const std::vector<const ggml_tensor *> fused = { mbx, tr, cc, vw, cp, sc, mc };
+    if (!ggml_cuda_decode_fusion_safe(q8c, cgraph, i, last, fused, { { mc->data, ny }, { cp->data, ns } }, { b, c, x, st, w })) {
+        return 0;
+    }
+    void * q8 = q8c.get_buf(n/QK8_1*sizeof(block_q8_1), cuda_ctx->stream());
+    if (!ggml_cuda_lfm_shortconv_decode(cuda_ctx->stream(), nc, n, (const float *) b->data, (const float *) c->data, (const float *) x->data,
+            (const float *) st->data, st->nb[1]/sizeof(float), (const float *) w->data, w->nb[1]/sizeof(float),
+            (float *) cp->data, (float *) mc->data, q8)) {
+        return 0;
+    }
+    for (const ggml_tensor * t : { cc, cp, sc, mc }) {
+        q8c.done.insert(t);
+    }
+    q8c.src = nullptr; // the done nodes are not scanned, so never keep an older entry
+    if (q8) {
+        q8c.src        = mc->data;
+        q8c.ne         = n;
+        q8c.next_check = i + 2;
+    }
+    return 1; // node i + 1 is the transpose view
+}
