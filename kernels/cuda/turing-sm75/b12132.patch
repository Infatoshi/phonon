+// batch-1 decode: [RMS_NORM, MUL, ADD, RMS_NORM, MUL] (post-norm + residual + next pre-norm) or a lone
+// [RMS_NORM, MUL] pre-norm become one kernel that also writes the q8_1 copy consumed by mul_mat_vec_q
+static int ggml_cuda_try_rms_norm_chain(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * norm = cgraph->nodes[i];
+    if (norm->op != GGML_OP_RMS_NORM) {
+        return 0;
+    }
+    ggml_cuda_q8_cache & q8c = ggml_cuda_get_q8_cache(cuda_ctx);
+    if (!q8c.enabled) {
+        return 0;
+    }
+    const ggml_tensor * x = norm->src[0];
+    const int64_t ncols = x->ne[0];
+    if (x->type != GGML_TYPE_F32 || ggml_nrows(x) != 1 || !ggml_is_contiguous(x) || ncols % MATRIX_ROW_PADDING != 0) {
+        return 0;
+    }
+
+    // weight operand of a MUL that consumes `prev`, must be a contiguous F32 vector of ncols
+    auto mul_weight = [&](const ggml_tensor * mul, const ggml_tensor * prev) -> const ggml_tensor * {
+        const ggml_tensor * w = mul->src[0] == prev ? mul->src[1] : mul->src[1] == prev ? mul->src[0] : nullptr;
+        if (!w || w->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) ||
+            ggml_nelements(w) != ncols || w->ne[0] != ncols || !ggml_is_contiguous(mul)) {
+            return nullptr;
+        }
+        return w;
+    };
+    auto aligned = [](const ggml_tensor * t) { return ((uintptr_t) t->data & 15) == 0; };
+
+    const bool is_chain =
+        i + 4 < cgraph->n_nodes &&
+        ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {}) &&
+        ggml_cuda_can_fuse(cgraph, i + 3, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {}) &&
+        cgraph->nodes[i + 3]->src[0] == cgraph->nodes[i + 2];
+
+    void * q8 = q8c.get_buf(ncols/QK8_1*sizeof(block_q8_1), cuda_ctx->stream());
+    if (q8 == nullptr) {
+        return 0;
+    }
+
+    if (is_chain) {
+        const ggml_tensor * mul1  = cgraph->nodes[i + 1];
+        const ggml_tensor * add   = cgraph->nodes[i + 2];
+        const ggml_tensor * norm2 = cgraph->nodes[i + 3];
+        const ggml_tensor * mul2  = cgraph->nodes[i + 4];
+        const ggml_tensor * w1  = mul_weight(mul1, norm);
+        const ggml_tensor * w2  = mul_weight(mul2, norm2);
+        const ggml_tensor * res = add->src[0] == mul1 ? add->src[1] : add->src[0];
+        if (w1 && w2 && res->type == GGML_TYPE_F32 && ggml_are_same_shape(res, x) && ggml_is_contiguous(res) &&
+            add->type == GGML_TYPE_F32 && ggml_is_contiguous(add) &&
+            aligned(x) && aligned(w1) && aligned(w2) && aligned(res) && aligned(add) && aligned(mul2)) {
+            float eps1, eps2;
+            memcpy(&eps1, norm->op_params,  sizeof(float));
+            memcpy(&eps2, norm2->op_params, sizeof(float));
+            if (ggml_cuda_rms_norm_chain(cuda_ctx->stream(), ncols, (const float *) x->data, (const float *) w1->data,
+                    (const float *) res->data, (float *) add->data, eps1, (const float *) w2->data, (float *) mul2->data, eps2, q8)) {
+                q8c.src        = mul2->data;
+                q8c.ne         = ncols;
+                q8c.next_check = i + 5;
+                return 4;
+            }
+        }
+        return 0;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {}) ||
+        !ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {}) ||
+        (i + 2 < cgraph->n_nodes && cgraph->nodes[i + 2]->op == GGML_OP_ROPE)) {
+        return 0;
+    }
+    const ggml_tensor * mul = cgraph->nodes[i + 1];
+    const ggml_tensor * w   = mul_weight(mul, norm);
+    if (w && aligned(x) && aligned(w) && aligned(mul)) {
+        float eps;
+        memcpy(&eps, norm->op_params, sizeof(float));
+        if (ggml_cuda_rms_norm_chain(cuda_ctx->stream(), ncols, (const float *) x->data, nullptr, nullptr, nullptr, 0.0f,
+                (const float *) w->data, (float *) mul->data, eps, q8)) {
+            q8c.src        = mul->data;
+            q8c.ne         = ncols;
+            q8c.next_check = i + 2;
+            return 1;
+        }
+    }
+    return 0;
+}
