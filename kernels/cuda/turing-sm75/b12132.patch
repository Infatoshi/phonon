+// Batch-1 decode attention output gate: y[h*hd + d] = attn[h*hd + d] * sigmoid(g[h])  (+ q8_1 copy of y).
+// Mirrors unary op_sigmoid followed by k_bin_bcast(op_mul) and quantize_q8_1.
+static __global__ void attn_gate_decode_f32(const float * __restrict__ attn, const float * __restrict__ g, const int hd,
+        float * __restrict__ y, block_q8_1 * __restrict__ q8, const int n) {
