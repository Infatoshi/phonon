+// Batch-1 decode of an LFM short convolution, one thread per channel:
+//   window = [state (nc-1 values) | b*x];  state <- window[1:];  y = c * sum_j window[j]*w[j]  (+ q8_1 copy of y)
+// Arithmetic mirrors k_bin_bcast(op_mul), concat, cpy, ssm_conv_f32 and quantize_q8_1 bit for bit.
+template <int nc>
+static __global__ void lfm_shortconv_decode_f32(
+        const float * __restrict__ b, const float * __restrict__ c, const float * __restrict__ x,
+        const float * __restrict__ state_in, const int state_in_stride,
+        const float * __restrict__ w, const int w_stride,
+        float * __restrict__ state_out, float * __restrict__ y, block_q8_1 * __restrict__ q8, const int n) {
+    const int ch = blockIdx.x*blockDim.x + threadIdx.x;
+    if (ch >= n) {
+        return;
+    }
+    float win[nc];
+#pragma unroll
+    for (int j = 0; j < nc - 1; ++j) {
+        win[j] = state_in[ch*state_in_stride + j];
+    }
+    win[nc - 1] = b[ch] * x[ch];
+#pragma unroll
+    for (int j = 0; j < nc - 1; ++j) {
+        state_out[ch*(nc - 1) + j] = win[j + 1];
+    }
+    float sumf = 0.0f;
+#pragma unroll
+    for (int j = 0; j < nc; ++j) {
+        sumf += win[j] * w[ch*w_stride + j];
+    }
+    const float bias = 0.0f;
+    sumf += bias;
+    const float v = c[ch] * sumf;
+    y[ch] = v;
+    if (q8) {
+        decode_store_q8_1(v, q8, ch);
+    }
