+// phonon: kernel_mul_mm's 64 x 32 tile and staging for few src1 rows, with KG groups of 4 simdgroups per threadgroup
+// taking interleaved 32-k steps (KG x the simdgroups in flight when few tiles exist: the M4 Max has 40 cores); the
+// groups' partial sums are added in group order at the end. Deterministic, not bit-identical to kernel_mul_mm.
+template<typename block_q, short nl, void (*dequantize_func)(device const block_q *, short, thread half4x4 &), short KG>
+kernel void kernel_mul_mm_sk(
+        constant ggml_metal_kargs_mul_mm & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiitg[[thread_index_in_threadgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    constexpr int NR0 = 64, NR1 = 32, NK = 32, NL0 = 2, NL1 = 4;
+
+    const short grp = tiitg/128, lt = tiitg%128, lsg = sgitg%4;
+
+    threadgroup half * sa = (threadgroup half *)(shmem + grp*6144);
+    threadgroup half * sb = sa + 64*32;
+
+    const int im = tgpig.z;
+    const int r0 = tgpig.y*NR0;
+    const int r1 = tgpig.x*NR1;
+
+    const short nr1 = (args.ne1 - r1 < NR1) ? (args.ne1 - r1) : NR1;
+
+    const short lr0 = lt/NL0, il0 = lt%NL0;
+    const short lr1 = lt/NL1, iy  = 8*(lt%NL1);
+
+    const int i12 = im % args.ne12;
+    const int i13 = im / args.ne12;
+
+    const uint64_t offset0 = (i12/args.r2)*args.nb02 + (i13/args.r3)*args.nb03;
+
+    device const block_q * x = (device const block_q *)(src0 + args.nb01*(r0 + lr0) + offset0);
+    device const float   * y = (device const float *)(src1 + args.nb13*i13 + args.nb12*i12 + args.nb11*(r1 + (lr1 < nr1 ? lr1 : nr1 - 1)) + args.nb10*iy);
+
+    simdgroup_half8x8  ma[4];
+    simdgroup_half8x8  mb[2];
+    simdgroup_float8x8 mc[8];
+
+    for (short i = 0; i < 8; i++) {
+        mc[i] = make_filled_simdgroup_matrix<float, 8>(0.f);
+    }
+
+    for (int loop_k = grp*NK; loop_k < args.ne00; loop_k += KG*NK) {
+        half4x4 temp_a;
+        dequantize_func(x + loop_k/(16*nl), (short) ((loop_k % (16*nl))/16 + il0), temp_a);
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        FOR_UNROLL (short i = 0; i < 16; i++) {
+            const short ib = 8*(2*il0 + i/8) + lr0/8;
+            *(sa + 64*ib + 8*(i%8) + lr0%8) = temp_a[i/4][i%4];
+        }
+        {
+            const short ib = 4*(lt%NL1) + lr1/8;
+            *(threadgroup half2x4 *)(sb + 64*ib + 8*(lr1%8)) = (half2x4)(*((device float2x4 *) (y + loop_k)));
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        threadgroup const half * lsma = sa + 4*64*(lsg%2);
+        threadgroup const half * lsmb = sb + 2*64*(lsg/2);
+
+        FOR_UNROLL (short ik = 0; ik < NK/8; ik++) {
+            simdgroup_barrier(mem_flags::mem_none);
+            FOR_UNROLL (short i = 0; i < 4; i++) {
+                simdgroup_load(ma[i], lsma + 64*i, 8, 0, false);
+            }
+            simdgroup_barrier(mem_flags::mem_none);
+            FOR_UNROLL (short i = 0; i < 2; i++) {
+                simdgroup_load(mb[i], lsmb + 64*i, 8, 0, false);
+            }
+            simdgroup_barrier(mem_flags::mem_none);
+            FOR_UNROLL (short i = 0; i < 8; i++) {
+                simdgroup_multiply_accumulate(mc[i], mb[i/4], ma[i%4], mc[i]);
+            }
+            lsma += 8*64;
+            lsmb += 4*64;
+        }
+    }
+
+    // groups 1.. park their partial sums, group 0 adds them in group order and stores
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    threadgroup float * part = (threadgroup float *) shmem;  // [group - 1][simdgroup][fragment][64]
+
+    if (grp > 0) {
+        FOR_UNROLL (short i = 0; i < 8; i++) {
+            simdgroup_store(mc[i], part + (((grp - 1)*4 + lsg)*8 + i)*64, 8, 0, false);
+        }
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (grp != 0) {
+        return;
+    }
+
+    FOR_UNROLL (short g = 1; g < KG; g++) {
+        FOR_UNROLL (short i = 0; i < 8; i++) {
+            simdgroup_float8x8 t;
+            simdgroup_load(t, part + (((g - 1)*4 + lsg)*8 + i)*64, 8, 0, false);
+            mc[i].thread_elements()[0] += t.thread_elements()[0];
+            mc[i].thread_elements()[1] += t.thread_elements()[1];
+        }
+    }
+
+    device float * D0 = (device float *) dst + (uint64_t) im*args.ne1*args.ne0;
+    threadgroup float * tmp = part + (KG - 1)*4*8*64 + 64*lsg;
+
+    FOR_UNROLL (short i = 0; i < 8; i++) {
+        const int n = r1 + 16*(lsg/2) + 8*(i/4);
+        const int m = r0 + 32*(lsg%2) + 8*(i%4);
+        if (n >= args.ne1) {
+            continue;
+        }
+        if (n + 8 <= args.ne1) {
+            simdgroup_store(mc[i], D0 + m + (uint64_t) n*args.ne0, args.ne0, 0, false);
+        } else {
+            simdgroup_store(mc[i], tmp, 8, 0, false);
+            simdgroup_barrier(mem_flags::mem_threadgroup);
+            for (short e = lt % 32; e < 64; e += 32) {
+                if (n + e/8 < args.ne1) {
+                    D0[(uint64_t) (n + e/8)*args.ne0 + m + e%8] = tmp[e];
+                }
+            }
+            simdgroup_barrier(mem_flags::mem_threadgroup);
+        }
+    }
+}
+
+typedef decltype(kernel_mul_mm_sk<block_q4_K, QK_NL, dequantize_q4_K, 2>) mul_mm_sk_t;
+
+template [[host_name("kernel_mul_mm_sk2_q4_K_f32")]] kernel mul_mm_sk_t kernel_mul_mm_sk<block_q4_K, QK_NL, dequantize_q4_K, 2>;
+template [[host_name("kernel_mul_mm_sk2_q5_K_f32")]] kernel mul_mm_sk_t kernel_mul_mm_sk<block_q5_K, QK_NL, dequantize_q5_K, 2>;
+template [[host_name("kernel_mul_mm_sk4_q4_K_f32")]] kernel mul_mm_sk_t kernel_mul_mm_sk<block_q4_K, QK_NL, dequantize_q4_K, 4>;
+template [[host_name("kernel_mul_mm_sk4_q5_K_f32")]] kernel mul_mm_sk_t kernel_mul_mm_sk<block_q5_K, QK_NL, dequantize_q5_K, 4>;
+
+typedef decltype(kernel_mul_mm_ph<block_q4_K, QK_NL, dequantize_q4_K>) mul_mm_ph_t;
+
+template [[host_name("kernel_mul_mm_ph_q4_K_f32")]] kernel mul_mm_ph_t kernel_mul_mm_ph<block_q4_K, QK_NL, dequantize_q4_K>;
+template [[host_name("kernel_mul_mm_ph_q5_K_f32")]] kernel mul_mm_ph_t kernel_mul_mm_ph<block_q5_K, QK_NL, dequantize_q5_K>;
+
 template<short ne20> // n_expert_used
 kernel void kernel_mul_mm_id_map0(
         constant ggml_metal_kargs_mul_mm_id_map0 & args,
diff --git a/ggml/src/ggml-metal/kernels/mul_mv.metal b/ggml/src/ggml-metal/kernels/mul_mv.metal
index 7ad07a2..62bb776 100644
--- a/ggml/src/ggml-metal/kernels/mul_mv.metal
+++ b/ggml/src/ggml-metal/kernels/mul_mv.metal
@@ -1628,6 +1628,241 @@ kernel void kernel_mul_mv_q4_K_f32(
     kernel_mul_mv_q4_K_f32_impl<N_R0_Q4_K, constant ggml_metal_kargs_mul_mv &>(args, src0, src1, dst, nullptr, tgpig, tiisg, sgitg);
