+// fused one-token short conv (LFM2/LFM3 decode): MUL (b*x) + CONCAT (state, bx) + CPY (state update) + SSM_CONV +
+// MUL (c*conv). one thread per channel; the thread reads its window before it writes its own state slots, so the
+// state may be updated in place. same products and summation order as the unfused kernels.
+// FC_ssm_conv_nc is the window length d_conv + 1
+kernel void kernel_shortconv_step_f32(
+        constant ggml_metal_kargs_shortconv_step & args,
+        device const float * b,
+        device const float * x,
+        device const float * c,
+        device const char  * sin,
+        device       float * sout,
+        device const char  * w,
+        device       float * y,
+        uint tpig[[thread_position_in_grid]]) {
+    const int ch = tpig;
+    if (ch >= args.nch) {
+        return;
+    }
+
+    const int nc = FC_ssm_conv_nc;
+
+    float s[8];
+    FOR_UNROLL (int i0 = 0; i0 < nc - 1; ++i0) {
+        s[i0] = *((device const float *) (sin + ch*args.nbs1 + i0*args.nbs0));
+    }
+    s[nc - 1] = b[ch]*x[ch];
+
+    device const float * wc = (device const float *) (w + ch*args.nbw1);
+
+    float sumf = 0.0f;
+    FOR_UNROLL (int i0 = 0; i0 < nc; ++i0) {
+        sumf += s[i0] * wc[i0];
+    }
+
+    FOR_UNROLL (int i0 = 0; i0 < nc - 1; ++i0) {
+        sout[ch*(nc - 1) + i0] = s[i0 + 1];
+    }
+
+    y[ch] = c[ch]*sumf;
+}
