+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    if (sgitg == 0) {
+        shmem_f32[tiisg] = 0.0f;
+    }
+
+    const int i01 = tgpig.x;
+    const int i00 = tpitg.x;
+    const bool active = i00 < args.ne00_t;
+
+    device const float4 * x  = (device const float4 *) (src0 + i01*args.nb01);
+    device const float4 * r  = (device const float4 *) (res  + i01*args.nb11);
+    device       float4 * ya = (device       float4 *) (dsta + i01*args.nb1a);
+    device       float4 * y  = (device       float4 *) (dst  + i01*args.nb1);
+    device const float4 * f0 = (device const float4 *) w0;
+    device const float4 * f1 = (device const float4 *) w1;
+
+    const float4 xv = active ? x[i00] : 0.0f;
+
+    float sumf = 0.0f;
+    if (active) {
+        sumf += dot(xv, xv);
+    }
+    sumf = simd_sum(sumf);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (tiisg == 0) {
+        shmem_f32[sgitg] = sumf;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    sumf = shmem_f32[tiisg];
+    sumf = simd_sum(sumf);
+
+    const float mean  = sumf/args.ne00;
+    const float scale = 1.0f/sqrt(mean + args.eps0);
+
+    float4 av = 0.0f;
+    if (active) {
+        av = (xv*scale)*f0[i00] + r[i00];
+        ya[i00] = av;
+    }
+
+    float sum2 = 0.0f;
+    if (active) {
+        sum2 += dot(av, av);
+    }
+    sum2 = simd_sum(sum2);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (tiisg == 0) {
+        shmem_f32[sgitg] = sum2;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    sum2 = shmem_f32[tiisg];
+    sum2 = simd_sum(sum2);
+
+    const float mean2  = sum2/args.ne00;
+    const float scale2 = 1.0f/sqrt(mean2 + args.eps1);
+
+    if (active) {
+        y[i00] = (av*scale2)*f1[i00];
+    }
+}
