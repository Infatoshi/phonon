+            const char * env = getenv("GGML_METAL_FUSION_SKIP");
+            if (!env) {
+                return;
+            }
+            const std::string list = std::string(",") + env + ",";
+            const struct { ggml_metal_fusion_id id; const char * name; } names[] = {
+                { GGML_METAL_FUSION_NORM_MUL,       "norm_mul"     },
+                { GGML_METAL_FUSION_NORM_MUL_ADD,   "norm_mul_add" },
+                { GGML_METAL_FUSION_MUL_MAT_SWIGLU, "swiglu"       },
+                { GGML_METAL_FUSION_NORM2,          "norm2"        },
+                { GGML_METAL_FUSION_SHORTCONV_STEP, "shortconv"    },
+                { GGML_METAL_FUSION_NORM_ROPE,      "norm_rope"    },
+                { GGML_METAL_FUSION_GATED_MUL_MAT,  "gated_mm"     },
+            };
+            for (const auto & n : names) {
+                skip[n.id] = list.find(std::string(",") + n.name + ",") != std::string::npos;
+            }
+        }
+    };
