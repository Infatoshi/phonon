+// replay the recording into a new command buffer on the prepare queue (not enqueued, not committed)
+static void ggml_metal_prepare_async(ggml_metal_t ctx) {
+    const uint64_t uid  = ctx->rec_uid;
+    const int      n_cb = ctx->rec_n_cb;
+    const bool     conc = ctx->use_concurrency;
+
+    id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+
+    dispatch_group_async(ctx->pre_group, ctx->pre_queue, ^{
+        @autoreleasepool {
+            const double t0 = ggml_metal_dbg_now();
+
+            id<MTLCommandBuffer> cmd_buf = [queue commandBufferWithUnretainedReferences];
+            [cmd_buf retain];
+
+            id<MTLComputeCommandEncoder> enc = conc
+                ? [cmd_buf computeCommandEncoderWithDispatchType:MTLDispatchTypeConcurrent]
+                : [cmd_buf computeCommandEncoder];
+
+            // GPU order of the recorded command buffers: cmd_bufs[n_cb] (main thread) first, then 0..n_cb-1;
+            // a buffer barrier stands in for each command buffer boundary
+            for (int k = 0; k <= n_cb; ++k) {
+                const int i = k == 0 ? n_cb : k - 1;
+                if (k > 0) {
+                    [enc memoryBarrierWithScope:MTLBarrierScopeBuffers];
+                }
+                ggml_metal_rec_replay(ctx->recs[i], enc);
+            }
+
+            [enc endEncoding];
+
+            ctx->pre_cb  = cmd_buf;
+            ctx->pre_uid = uid;
+
+            ggml_metal_dbg[3] += ggml_metal_dbg_now() - t0; // replay time (off the critical path)
+        }
+    });
+}
