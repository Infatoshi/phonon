+// RMS_NORM + MUL + ROPE (neox) for per-head q/k norms, optionally followed by SET_ROWS of the rotated heads into an
+// f16 KV cache row. one simdgroup per (head, token): the norm uses the partition of kernel_rms_norm_mul_f32_4 with
+// 32 threads, the rotation the per-pair arithmetic of kernel_rope_neox, so the results match the unfused kernels
+kernel void kernel_rms_norm_mul_rope_neox_f32(
+        constant ggml_metal_kargs_norm_rope & args,
+        device const char * src0,
+        device const char * w,
+        device const char * pos,
+        device const char * ff,
+        device       char * dst,
+        device const char * idx,
+        device       char * cache,
+        threadgroup float * shmem [[threadgroup(0)]],
+        ushort tiitg[[thread_index_in_threadgroup]],
+        uint3  tgpig[[threadgroup_position_in_grid]]) {
+    const int i1 = tgpig[0];
+    const int i2 = tgpig[1];
+
+    const int ne00_t = args.ne00/4;
+    const bool active = tiitg < ne00_t;
+
+    device const float4 * x  = (device const float4 *) (src0 + i2*args.nb02 + i1*args.nb01);
+    device const float4 * f0 = (device const float4 *) w;
+
+    const float4 xv = active ? x[tiitg] : 0.0f;
+
+    float sumf = 0.0f;
+    if (active) {
+        sumf += dot(xv, xv);
+    }
+    sumf = simd_sum(sumf);
+
+    const float mean  = sumf/args.ne00;
+    const float scale = 1.0f/sqrt(mean + args.eps);
+
+    if (active) {
+        const float4 yv = (xv*scale)*f0[tiitg];
+        shmem[4*tiitg + 0] = yv[0];
+        shmem[4*tiitg + 1] = yv[1];
+        shmem[4*tiitg + 2] = yv[2];
+        shmem[4*tiitg + 3] = yv[3];
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    float corr_dims[2];
+    rope_yarn_corr_dims(args.n_dims, args.n_ctx_orig, args.freq_base, args.beta_fast, args.beta_slow, corr_dims);
+
+    const float theta_base = (float) ((device const int32_t *) pos)[i2];
+    const float inv_ndims = -1.f/args.n_dims;
+
+    device float * d = (device float *) (dst + i2*args.nb2 + i1*args.nb1);
+
+    device half * c = nullptr;
+    if (args.set_rows) {
+        const int64_t r = args.idx_i64 ? ((device const int64_t *) (idx + i2*args.nbi0))[0]
+                                       : (int64_t) ((device const int32_t *) (idx + i2*args.nbi0))[0];
+        c = (device half *) (cache + r*args.nbr1) + i1*args.ne00;
+    }
+
+    float cos_theta;
+    float sin_theta;
+
+    for (int i0 = 2*tiitg; i0 < args.ne00; i0 += 2*32) {
+        if (i0 >= args.n_offs && i0 < args.n_offs + args.n_dims) {
+            const int iw = i0 - args.n_offs;
+            const int ic = iw/2;
+
+            const float theta = theta_base * pow(args.freq_base, inv_ndims*iw);
+
+            const float freq_factor = args.src2 ? ((device const float *) ff)[ic] : 1.0f;
+
+            rope_yarn(theta/freq_factor, args.freq_scale, corr_dims, iw, args.ext_factor, args.attn_factor, &cos_theta, &sin_theta);
+
+            const int j0 = args.n_offs + ic;
+            const int j1 = j0 + args.n_dims/2;
+
+            const float x0 = shmem[j0];
+            const float x1 = shmem[j1];
+
+            const float y0 = x0*cos_theta - x1*sin_theta;
+            const float y1 = x0*sin_theta + x1*cos_theta;
+
+            d[j0] = y0;
+            d[j1] = y1;
+            if (args.set_rows) {
+                c[j0] = (half) y0;
+                c[j1] = (half) y1;
+            }
+        } else {
+            d[i0 + 0] = shmem[i0 + 0];
+            d[i0 + 1] = shmem[i0 + 1];
+            if (args.set_rows) {
+                c[i0 + 0] = (half) shmem[i0 + 0];
+                c[i0 + 1] = (half) shmem[i0 + 1];
+            }
+        }
+    }
+}
