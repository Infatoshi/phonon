+    const int n_dims    = ((const int32_t *) rope->op_params)[1];
+    const int n_offs    = ((const int32_t *) rope->op_params)[15];
+    if (mode_rope != GGML_ROPE_TYPE_NEOX || n_dims % 2 != 0 || n_offs % 2 != 0 || n_offs + n_dims > ne00) {
+        return false;
+    }
