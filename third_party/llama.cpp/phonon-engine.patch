+bool llama_phonon_copy_bx(struct llama_context * ctx, int32_t il, int32_t n_tokens, float * dst, size_t dst_stride) {
+    ctx->synchronize();  // the decode may still be running on the GPU (llama.cpp syncs lazily, on output reads)
+    const llm_graph_result * res = ctx->phonon_res;
+    if (!res || !res->phonon_bx) {
+        return false;
+    }
+    char name[64];
+    snprintf(name, sizeof name, "phonon_bx-%d", il);
+    ggml_tensor * t = ggml_graph_get_tensor(res->get_gf(), name);
+    if (!t || t->type != GGML_TYPE_F32 || t->ne[2] != 1 || !ggml_is_contiguous(t) || n_tokens > t->ne[0]) {
+        return false;
+    }
+    const int64_t T = t->ne[0], C = t->ne[1];
+    std::vector<float> buf((size_t) T * C);
+    ggml_backend_tensor_get(t, buf.data(), 0, ggml_nbytes(t));
+    for (int64_t ch = 0; ch < C; ++ch) {
+        memcpy(dst + (size_t) ch * dst_stride, buf.data() + (size_t) ch * T + (T - n_tokens), (size_t) n_tokens * sizeof(float));
+    }
+    return true;
+}
