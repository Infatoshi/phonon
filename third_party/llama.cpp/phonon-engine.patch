+bool llama_phonon_truncate(struct llama_context * ctx, int32_t n_pos, const float * const * conv_states) {
+    auto * mem = dynamic_cast<llama_memory_hybrid_iswa *>(llama_get_memory(ctx));
+    if (!mem || n_pos < 1) {
+        return false;
+    }
+    mem->get_mem_attn()->seq_rm(0, n_pos, -1);
+    auto * recr = mem->get_mem_recr();
+    const int32_t cell = recr->cells[0].tail;
+    if (cell < 0) {
+        return false;
+    }
+    for (int32_t il = 0; il < (int32_t) recr->r_l.size(); ++il) {
+        ggml_tensor * r = recr->r_l[il];
+        if (!r) {
+            continue;
+        }
+        if (!conv_states[il] || r->type != GGML_TYPE_F32) {
+            return false;
+        }
+        ggml_backend_tensor_set(r, conv_states[il], (size_t) cell * r->nb[1], ggml_row_size(r->type, r->ne[0]));
+    }
+    recr->cells[cell].pos = n_pos - 1;
+    return true;
+}
+
+bool llama_phonon_export_range(struct llama_context * ctx, int32_t il, int32_t p0, int32_t n_pos, void * k_out, void * v_out, float * conv_out) {
+    ctx->synchronize();  // the last decode may still be running on the GPU
+    auto * mem = dynamic_cast<llama_memory_hybrid_iswa *>(llama_get_memory(ctx));
+    if (!mem) {
+        return false;
+    }
+    if (k_out || v_out) {
+        auto * attn = mem->get_mem_attn();
+        if (!attn->get_base()->phonon_export(il, n_pos, k_out, v_out, p0) &&
+            !attn->get_swa()->phonon_export(il, n_pos, k_out, v_out, p0)) {
+            return false;
+        }
+    }
+    if (conv_out) {
+        auto * recr = mem->get_mem_recr();
+        const int32_t cell = recr->cells[0].tail;
+        ggml_tensor * r = il < (int32_t) recr->r_l.size() ? recr->r_l[il] : nullptr;
+        if (cell < 0 || !r || r->type != GGML_TYPE_F32) {
+            return false;
+        }
+        ggml_backend_tensor_get(r, conv_out, (size_t) cell * r->nb[1], ggml_row_size(r->type, r->ne[0]));
+    }
+    return true;
+}
