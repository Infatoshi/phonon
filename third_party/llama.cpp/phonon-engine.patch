+void ggml_metal_rec_reset(ggml_metal_rec_t rec) {
+    rec->n_cmds  = 0;
+    rec->n_bytes = 0;
+}
+
+int ggml_metal_rec_n_cmds(ggml_metal_rec_t rec) {
+    return rec->n_cmds;
+}
+
+static struct ggml_metal_rec_cmd * ggml_metal_rec_push(ggml_metal_rec_t rec, uint8_t type) {
+    if (rec->n_cmds == rec->cap_cmds) {
+        rec->cap_cmds = rec->cap_cmds ? 2*rec->cap_cmds : 4096;
+        rec->cmds = realloc(rec->cmds, rec->cap_cmds*sizeof(struct ggml_metal_rec_cmd));
+        GGML_ASSERT(rec->cmds);
+    }
+    struct ggml_metal_rec_cmd * cmd = &rec->cmds[rec->n_cmds++];
+    memset(cmd, 0, sizeof(*cmd));
+    cmd->type = type;
+    return cmd;
