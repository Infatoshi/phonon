+        if (view->op != GGML_OP_VIEW || view->view_src != rope || view->view_offs != 0 ||
+            view->ne[0] != ne00*x->ne[1] || view->ne[1] != x->ne[2] || view->ne[2] != 1 || view->ne[3] != 1 ||
+            view->nb[1] != rope->nb[2] || rope->nb[1] != ne00*sizeof(float)) {
