+//
+// command recorder: captures the exact sequence of encoder calls of a graph so that it can be replayed into a
+// fresh command buffer without walking the graph again (no pipeline lookups, fusion or concurrency analysis)
+//
+
+enum ggml_metal_rec_type {
+    GGML_METAL_REC_PIPELINE,
+    GGML_METAL_REC_BYTES,
+    GGML_METAL_REC_BUFFER,
+    GGML_METAL_REC_TGMEM,
+    GGML_METAL_REC_DISPATCH,
+    GGML_METAL_REC_BARRIER,
+};
+
+struct ggml_metal_rec_cmd {
+    uint8_t  type;
+    uint8_t  idx;
+    int32_t  tg[6];
+    void   * obj;   // id<MTLComputePipelineState> or id<MTLBuffer> (not retained: pipelines live as long as the
+                    // library, buffers must stay alive while the graph that references them is in use)
+    size_t   offs;  // buffer offset, threadgroup memory size, or offset into the bytes arena
+    size_t   size;  // size of the bytes
+};
+
+struct ggml_metal_rec {
+    struct ggml_metal_rec_cmd * cmds;
+    int n_cmds;
+    int cap_cmds;
+
+    uint8_t * bytes;
+    size_t n_bytes;
+    size_t cap_bytes;
+};
