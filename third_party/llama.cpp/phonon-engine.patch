+        const int m = r0 + 32*(sgitg%2) + 8*(i%4);
+        if (n >= args.ne1) {
+            continue;
+        }
+        if (n + 8 <= args.ne1) {
+            simdgroup_store(mc[i], D0 + m + (uint64_t) n*args.ne0, args.ne0, 0, false);
+        } else {
+            simdgroup_store(mc[i], tmp, 8, 0, false);
+            simdgroup_barrier(mem_flags::mem_threadgroup);
+            for (short e = tiitg % 32; e < 64; e += 32) {
+                if (n + e/8 < args.ne1) {
+                    D0[(uint64_t) (n + e/8)*args.ne0 + m + e%8] = tmp[e];
+                }
+            }
+            simdgroup_barrier(mem_flags::mem_threadgroup);
+        }
+    }
+}
