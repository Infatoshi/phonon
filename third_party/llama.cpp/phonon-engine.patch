+bool llama_kv_cache::phonon_export(int32_t il, int32_t n_pos, void * k_out, void * v_out, int32_t p0) const {
+    // positions p0 .. n_pos - 1 go to rows p0 .. n_pos - 1 of k_out / v_out
+    const auto it = map_layer_ids.find(il);
+    if (it == map_layer_ids.end()) {
+        return false;
+    }
+    const auto & layer = layers[it->second];
+    const uint32_t strm = seq_to_stream[0];
+    const auto & cells = v_cells[strm];
+    const uint32_t kv_size = cells.size();
+
+    // cell of each position, and the cell range used
+    std::vector<int32_t> cell_of(n_pos, -1);
+    uint32_t lo = kv_size, hi = 0;
+    for (uint32_t i = 0; i < kv_size; ++i) {
+        if (cells.is_empty(i) || !cells.seq_has(i, 0)) {
+            continue;
+        }
+        const llama_pos p = cells.pos_get(i);
+        if (p >= p0 && p < n_pos) {
+            cell_of[p] = (int32_t) i;
+            lo = std::min(lo, i);
+            hi = std::max(hi, i + 1);
+        }
+    }
+    for (int32_t p = p0; p < n_pos; ++p) {
+        if (cell_of[p] < 0) {
+            return false;
+        }
+    }
+    if (p0 >= n_pos) {
+        return true;
+    }
+
+    ggml_tensor * k = layer.k_stream[strm];
+    ggml_tensor * v = layer.v_stream[strm];
+    const size_t k_row = ggml_row_size(k->type, hparams.n_embd_k_gqa(il));
+    std::vector<uint8_t> buf((size_t) (hi - lo) * k_row);
+    ggml_backend_tensor_get(k, buf.data(), (size_t) lo * k_row, buf.size());
+    for (int32_t p = p0; p < n_pos; ++p) {
+        memcpy((uint8_t *) k_out + (size_t) p * k_row, buf.data() + (size_t) (cell_of[p] - lo) * k_row, k_row);
+    }
+
+    const uint32_t n_embd_v = hparams.n_embd_v_gqa(il);
+    if (!v_trans) {
+        const size_t v_row = ggml_row_size(v->type, n_embd_v);
+        buf.resize((size_t) (hi - lo) * v_row);
+        ggml_backend_tensor_get(v, buf.data(), (size_t) lo * v_row, buf.size());
+        for (int32_t p = p0; p < n_pos; ++p) {
+            memcpy((uint8_t *) v_out + (size_t) p * v_row, buf.data() + (size_t) (cell_of[p] - lo) * v_row, v_row);
+        }
+    } else {
+        // transposed: element (cell, j) at j * kv_size + cell; read rows j up to the highest cell
+        const size_t el = ggml_type_size(v->type);
+        if (el != 2) {
+            return false;
+        }
+        buf.resize(((size_t) (n_embd_v - 1) * kv_size + hi) * el);
+        ggml_backend_tensor_get(v, buf.data(), 0, buf.size());
+        const uint16_t * src = (const uint16_t *) buf.data();
+        uint16_t * dst = (uint16_t *) v_out;
+        for (int32_t p = p0; p < n_pos; ++p) {
+            const uint32_t c = (uint32_t) cell_of[p];
+            for (uint32_t j = 0; j < n_embd_v; ++j) {
+                dst[(size_t) p * n_embd_v + j] = src[(size_t) j * kv_size + c];
+            }
+        }
+    }
+    return true;
+}
