+// MUL + MUL_MAT: the activation of a one-token Q4_K matvec is a per-head gated tensor (attention output times a
+// [1, n_head] gate broadcast over the head size); the gated product is formed inside the matvec
+static bool ggml_metal_fusion_check_gated_mul_mat(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(fusion);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+
+    const ggml_tensor * mul = nodes[0];
+    const ggml_tensor * mm  = nodes[1];
+
+    const ggml_tensor * act  = mul->src[0];
+    const ggml_tensor * gate = mul->src[1];
+    const ggml_tensor * in   = mm->src[1];
+
+    if (in->op != GGML_OP_RESHAPE || in->view_src != mul) {
+        return false;
+    }
+
+    const int64_t hd = act->ne[0];
+    const int64_t nh = act->ne[1];
+
+    if (act->type != GGML_TYPE_F32 || gate->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 ||
+        hd % 64 != 0 || act->nb[0] != sizeof(float) || act->nb[1] != hd*sizeof(float) || act->ne[3] != 1 ||
+        gate->ne[0] != 1 || gate->ne[1] != nh || gate->ne[2] != act->ne[2] || gate->ne[3] != 1 || gate->nb[1] != sizeof(float) ||
+        !ggml_are_same_shape(mul, act) || !ggml_is_contiguous(mul)) {
+        return false;
+    }
+
+    const ggml_tensor * w = mm->src[0];
+    if (w->type != GGML_TYPE_Q4_K || w->ne[0] != hd*nh || w->ne[2] != 1 || w->ne[3] != 1 || !ggml_is_contiguous(w) ||
+        in->ne[0] != hd*nh || !ggml_is_contiguous(mm)) {
+        return false;
+    }
+
+    if (ggml_metal_fusion_use_count(gf, mul) != 1 || ggml_metal_fusion_use_count(gf, in) != 1) {
+        return false;
+    }
+
+    if (mode == GGML_METAL_FUSION_STRUCTURAL) {
+        return true;
+    }
+
+    // one token
+    if (act->ne[2] != 1 || in->ne[1] != 1 || in->ne[2] != 1 || in->ne[3] != 1) {
+        return false;
+    }
+
+    return !ggml_metal_fusion_overlap(mm, act) && !ggml_metal_fusion_overlap(mm, gate) && !ggml_metal_fusion_overlap(mm, w);
