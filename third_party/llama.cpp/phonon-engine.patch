+[[host_name("kernel_mul_mv_q4_K_f32_gated")]]
+kernel void kernel_mul_mv_q4_K_f32_gated(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        device const char * gate,
+        constant int      & hd,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+
+    kernel_mul_mv_q4_K_f32_gated_impl<N_R0_Q4_K, constant ggml_metal_kargs_mul_mv &>(args, src0, src1, dst, (device const float *) gate, hd, tgpig, tiisg, sgitg);
+}
+
+// fused FFN gate + up + swiglu for one token (MUL_MAT gate, MUL_MAT up, GLU swiglu):
+// each simdgroup computes row r of the gate weights (src0) and row r of the up weights (src0b) with the
+// same per-row arithmetic as kernel_mul_mv_q4_K_f32, then writes silu(gate)*up as kernel_swiglu does
+[[host_name("kernel_mul_mv_q4_K_f32_swiglu")]]
+kernel void kernel_mul_mv_q4_K_f32_swiglu(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        device const char * src0b,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    const short NSG = FC_mul_mv_nsg;
+
+    constexpr uint16_t kmask1 = 0x3f3f;
+    constexpr uint16_t kmask2 = 0x0f0f;
+    constexpr uint16_t kmask3 = 0xc0c0;
+
+    const short ix = tiisg/8;  // 0...3
+    const short it = tiisg%8;  // 0...7
+    const short iq = it/4;     // 0 or 1
+    const short ir = it%4;     // 0...3
+
+    const int nb = args.ne00/QK_K;
+
+    const int row = tgpig.x * NSG + sgitg;
+    if (row >= args.ne01) {
+        return;
+    }
+
+    device const block_q4_K * xs[2] = {
+        (device const block_q4_K *) (src0  + (uint64_t) row*args.nb01),
+        (device const block_q4_K *) (src0b + (uint64_t) row*args.nb01),
+    };
+    device const float * y = (device const float *) src1;
+
+    float yl[16];
+    float yh[16];
+
+    float sumf[2] = { 0.f, 0.f };
+
+    device const float * y4 = y + ix * QK_K + 64 * iq + 8 * ir;
+
+    uint16_t sc16[4];
+    thread const uint8_t * sc8 = (thread const uint8_t *)sc16;
+
+    for (int ib = ix; ib < nb; ib += 4) {
+        float4 sumy = {0.f, 0.f, 0.f, 0.f};
+
+        for (short i = 0; i < 8; ++i) {
+            yl[i+0] = y4[i+  0]; sumy[0] += yl[i+0];
+            yl[i+8] = y4[i+ 32]; sumy[1] += yl[i+8];
+            yh[i+0] = y4[i+128]; sumy[2] += yh[i+0];
+            yh[i+8] = y4[i+160]; sumy[3] += yh[i+8];
+        }
+
+        FOR_UNROLL (short r = 0; r < 2; r++) {
+            device const uint16_t * sc = (device const uint16_t *)xs[r][ib].scales + iq;
+            device const uint16_t * q1 = (device const uint16_t *)xs[r][ib].qs + 16 * iq + 4 * ir;
+            device const half     * dh = &xs[r][ib].d;
+
+            sc16[0] = sc[0] & kmask1;
+            sc16[1] = sc[2] & kmask1;
+            sc16[2] = ((sc[4] >> 0) & kmask2) | ((sc[0] & kmask3) >> 2);
+            sc16[3] = ((sc[4] >> 4) & kmask2) | ((sc[2] & kmask3) >> 2);
+
+            device const uint16_t * q2 = q1 + 32;
+
+            float4 acc1 = {0.f, 0.f, 0.f, 0.f};
+            float4 acc2 = {0.f, 0.f, 0.f, 0.f};
+
+            FOR_UNROLL (short i = 0; i < 4; ++i) {
+                acc1[0] += yl[2*i + 0] * (q1[i] & 0x000F);
+                acc1[1] += yl[2*i + 1] * (q1[i] & 0x0F00);
+                acc1[2] += yl[2*i + 8] * (q1[i] & 0x00F0);
+                acc1[3] += yl[2*i + 9] * (q1[i] & 0xF000);
+                acc2[0] += yh[2*i + 0] * (q2[i] & 0x000F);
+                acc2[1] += yh[2*i + 1] * (q2[i] & 0x0F00);
+                acc2[2] += yh[2*i + 8] * (q2[i] & 0x00F0);
+                acc2[3] += yh[2*i + 9] * (q2[i] & 0xF000);
+            }
+
+            sumf[r] += dh[0] * ((acc1[0] + 1.f/256.f * acc1[1]) * sc8[0] +
+                                (acc1[2] + 1.f/256.f * acc1[3]) * sc8[1] * 1.f/16.f +
+                                (acc2[0] + 1.f/256.f * acc2[1]) * sc8[4] +
+                                (acc2[2] + 1.f/256.f * acc2[3]) * sc8[5] * 1.f/16.f) -
+                       dh[1] * (sumy[0] * sc8[2] + sumy[1] * sc8[3] + sumy[2] * sc8[6] + sumy[3] * sc8[7]);
+        }
+
+        y4 += 4 * QK_K;
+    }
+
+    const float g = simd_sum(sumf[0]);
+    const float u = simd_sum(sumf[1]);
+
+    if (tiisg == 0) {
+        const float silu = g / (1.0f + exp(-g));
+        ((device float *) dst)[row] = silu*u;
+    }
+}
