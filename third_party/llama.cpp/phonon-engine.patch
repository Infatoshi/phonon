+ggml_metal_rec_t ggml_metal_rec_init(void) {
+    return calloc(1, sizeof(struct ggml_metal_rec));
+}
+
+void ggml_metal_rec_free(ggml_metal_rec_t rec) {
+    if (!rec) {
+        return;
+    }
+    free(rec->cmds);
+    free(rec->bytes);
+    free(rec);
+}
